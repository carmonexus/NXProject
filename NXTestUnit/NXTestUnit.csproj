<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>NXTestUnit</AssemblyName>
    <RootNamespace>NXTestUnit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <ProjectReference Include="..\NXProject.Shared\NXProject.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\NXProject.Shared\ViewModels\TaskViewModel.cs">
      <Link>ViewModels\TaskViewModel.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Shared\ViewModels\GroupViewModels.cs">
      <Link>ViewModels\GroupViewModels.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Shared\ViewModels\MainViewModel.cs">
      <Link>ViewModels\MainViewModel.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Shared\ViewModels\MainViewModel.AI.cs">
      <Link>ViewModels\MainViewModel.AI.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Community\Services\AppStrings.cs">
      <Link>Services\AppStrings.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Community\Services\UpdateService.cs">
      <Link>Services\UpdateService.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Community\Services\ExcelTaskPlanService.cs">
      <Link>Services\ExcelTaskPlanService.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Community\Services\TaskPlanScheduleRules.cs">
      <Link>Services\TaskPlanScheduleRules.cs</Link>
    </Compile>
    <Compile Include="..\NXProject.Community\Services\TaskPlanSettingsStore.cs">
      <Link>Services\TaskPlanSettingsStore.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="PackagingManifests\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
