<Window x:Class="NXProject.Views.PdfExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Pdf_Title}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">

    <StackPanel Margin="24,20,24,20">

        <!-- Layout -->
        <TextBlock Text="{DynamicResource Pdf_LayoutHeader}" FontSize="13" FontWeight="Bold"
                   Foreground="#2B579A" Margin="0,0,0,12"/>

        <RadioButton x:Name="RadioTogether" GroupName="Layout" IsChecked="True"
                     Margin="0,0,0,8" FontSize="12"
                     Checked="OnLayoutChanged" Unchecked="OnLayoutChanged">
            <StackPanel>
                <TextBlock Text="{DynamicResource Pdf_Together}" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Pdf_TogetherHint}"
                           FontSize="10" Foreground="#666" Margin="0,2,0,0"/>
            </StackPanel>
        </RadioButton>

        <!-- Tamanho de página (só visível quando "tudo junto") -->
        <Border x:Name="SizePanel" Margin="20,0,0,12" Padding="12,10"
                Visibility="Visible"
                Background="#EEF4FB" BorderBrush="#B8D0EC" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="{DynamicResource Pdf_PageSize}" FontSize="11" FontWeight="SemiBold"
                           Foreground="#2B579A" Margin="0,0,0,8"/>
                <RadioButton x:Name="SizeA3" GroupName="PageSize"
                             FontSize="11" Margin="0,0,0,4">
                    <TextBlock><Run FontWeight="SemiBold" Text="{DynamicResource Pdf_A3}"/><Run Foreground="#666" Text="{DynamicResource Pdf_A3Desc}"/></TextBlock>
                </RadioButton>
                <RadioButton x:Name="SizeA2" GroupName="PageSize" IsChecked="True"
                             FontSize="11">
                    <TextBlock><Run FontWeight="SemiBold" Text="{DynamicResource Pdf_A2}"/><Run Foreground="#666" Text="{DynamicResource Pdf_A2Desc}"/></TextBlock>
                </RadioButton>
            </StackPanel>
        </Border>

        <RadioButton x:Name="RadioTwoPages" GroupName="Layout"
                     Margin="0,0,0,4" FontSize="12"
                     Checked="OnLayoutChanged" Unchecked="OnLayoutChanged">
            <StackPanel>
                <TextBlock Text="{DynamicResource Pdf_TwoPages}" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Pdf_TwoPagesHint}"
                           FontSize="10" Foreground="#666" Margin="0,2,0,0"/>
            </StackPanel>
        </RadioButton>

        <Separator Margin="0,16,0,16"/>

        <TextBlock Text="{DynamicResource Pdf_TimelineHeader}" FontSize="13" FontWeight="Bold"
                   Foreground="#2B579A" Margin="0,0,0,8"/>
        <TextBlock Text="{DynamicResource Pdf_TimelineHint}"
                   FontSize="10" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Pdf_DaysBefore}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="DaysBeforeBox"
                         Text="0"
                         Height="28"
                         Padding="8,3"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource Pdf_DaysAfter}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="DaysAfterBox"
                         Text="0"
                         Height="28"
                         Padding="8,3"
                         VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText"
                   FontSize="10"
                   Foreground="#B00020"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- Botões -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Pdf_Export}" Width="90" Height="30" Margin="0,0,8,0"
                    IsDefault="True" Click="OnExportClick"
                    Background="#2B579A" Foreground="White" FontWeight="SemiBold"
                    BorderThickness="0"/>
            <Button Content="{DynamicResource Pdf_Cancel}" Width="90" Height="30"
                    IsCancel="True" Click="OnCancelClick"
                    Background="#E5E8ED" Foreground="#333"
                    BorderThickness="0"/>
        </StackPanel>

    </StackPanel>
</Window>
