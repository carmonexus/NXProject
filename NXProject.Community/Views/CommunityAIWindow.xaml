<Window x:Class="NXProject.Views.CommunityAIWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource AI_WindowTitle}"
        Width="1180"
        Height="720"
        MinWidth="1040"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Window.Resources>
        <!-- Botões que trocam a visão (substituem as abas do assistente) -->
        <Style x:Key="AiTabButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#2B579A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{DynamicResource AI_Title}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#2B579A"/>
                <TextBlock Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="#444"
                           Text="{DynamicResource AI_Intro}"/>
                <TextBlock Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="#555"
                           Text="{DynamicResource AI_SecretNote}"/>
            </StackPanel>

            <!-- Coluna esquerda: o que era a aba "Geral" agora fica SEMPRE visível.
                 Coluna direita: provedor padrão, botões e as visões restantes. -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <Border Padding="14" CornerRadius="8"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_ScheduleMode_Label}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource AI_ScheduleMode_Desc}"
                                           TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"/>
                                <CheckBox x:Name="CreateTasksCheck"
                                          Content="{DynamicResource AI_CreateTaskCheck}"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="14" CornerRadius="8" Margin="0,12,0,0"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_ContextRules}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource AI_ProjectContextLabel}" FontWeight="SemiBold"/>
                                <TextBox x:Name="ProjectContextTextBox" Margin="0,6,0,10" Height="92"
                                         IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="{DynamicResource AI_AllowedScope}" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555"
                                           Text="{DynamicResource AI_AllowedScope_Desc}"/>
                            </StackPanel>
                        </Border>

                        <!-- Tipos de acao com IA -->
                        <Border Padding="14" CornerRadius="8" Margin="0,12,0,0"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_ActionType_Label}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_ActionType_Desc}"/>

                                <ComboBox x:Name="ActionTypeCombo" Height="30" Margin="0,0,0,6"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="OnActionTypeSelectionChanged"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="{DynamicResource AI_NewAction}" Width="64" Height="30" Click="OnNewActionClick"/>
                                    <Button Content="{DynamicResource AI_DeleteAction}" Width="64" Height="30" Margin="6,0,0,0" Click="OnDeleteActionClick"/>
                                    <Button Content="{DynamicResource AI_RestoreDefaults}" Width="120" Height="30" Margin="6,0,0,0" Click="OnRestoreDefaultActionsClick"/>
                                </StackPanel>

                                <TextBlock Text="{DynamicResource AI_ActionNameLabel}" FontWeight="SemiBold"/>
                                <TextBox x:Name="ActionNameBox" Margin="0,4,0,8" Height="28"
                                         TextChanged="OnActionFieldChanged"/>
                                <CheckBox x:Name="ActionCreatesTasksCheck" Content="{DynamicResource AI_ActionCreatesTasks}"
                                          Margin="0,0,0,8" Click="OnActionFieldChanged"/>
                                <TextBlock Text="{DynamicResource AI_ActionPromptLabel}" FontWeight="SemiBold"/>
                                <TextBox x:Name="ActionPromptBox" Margin="0,4,0,8" Height="150"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                         TextChanged="OnActionFieldChanged"/>

                                <TextBlock Text="{DynamicResource AI_AnalysisTaskLimitLabel}" FontWeight="SemiBold"/>
                                <TextBox x:Name="AnalysisTaskLimitBox" Margin="0,4,0,0" Height="28" Width="120"
                                         HorizontalAlignment="Left"/>
                                <TextBlock Text="{DynamicResource AI_AnalysisTaskLimitDesc}"
                                           TextWrapping="Wrap" Foreground="#555" FontSize="11" Margin="0,4,0,0"/>

                                <TextBlock Text="{DynamicResource AI_ChatHistoryLimitLabel}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                <TextBox x:Name="ChatHistoryLimitBox" Margin="0,4,0,0" Height="28" Width="120"
                                         HorizontalAlignment="Left"/>
                                <TextBlock Text="{DynamicResource AI_ChatHistoryLimitDesc}"
                                           TextWrapping="Wrap" Foreground="#555" FontSize="11" Margin="0,4,0,0"/>

                                <TextBlock Text="{DynamicResource AI_ChatHistoryWindowLabel}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                <TextBox x:Name="ChatHistoryWindowBox" Margin="0,4,0,0" Height="28" Width="120"
                                         HorizontalAlignment="Left"/>
                                <TextBlock Text="{DynamicResource AI_ChatHistoryWindowDesc}"
                                           TextWrapping="Wrap" Foreground="#555" FontSize="11" Margin="0,4,0,0"/>

                                <TextBlock Text="{DynamicResource AI_ChatCompressLabel}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                <TextBox x:Name="ChatCompressBox" Margin="0,4,0,0" Height="28" Width="120"
                                         HorizontalAlignment="Left"/>
                                <TextBlock Text="{DynamicResource AI_ChatCompressDesc}"
                                           TextWrapping="Wrap" Foreground="#555" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            <DockPanel Grid.Column="2">
                <!-- Provedor padrão sempre visível, ACIMA dos botões; mudou = salvo automaticamente -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource AI_DefaultProvider_Label}" VerticalAlignment="Center"
                               FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ComboBox x:Name="DefaultProviderCombo" Height="30" Width="185"
                              SelectionChanged="OnDefaultProviderChanged"
                              ToolTip="{DynamicResource AI_DefaultProvider_Desc}">
                        <ComboBoxItem Content="OpenAI" Tag="OpenAI"/>
                        <ComboBoxItem Content="Azure OpenAI" Tag="AzureOpenAI"/>
                        <ComboBoxItem Content="OpenRouter" Tag="OpenRouter"/>
                        <ComboBoxItem Content="IA Local (LLaMA)" Tag="LocalLlama"/>
                        <ComboBoxItem Content="Claude (API Anthropic)" Tag="Claude"/>
                        <ComboBoxItem Content="Codex (local)" Tag="CodexCli"/>
                        <ComboBoxItem Content="Claude Code (local)" Tag="ClaudeCli"/>
                        <ComboBoxItem Content="Microsoft 365 (conta da empresa)" Tag="Microsoft365"/>
                    </ComboBox>
                    <Button x:Name="RestoreAllDefaultsButton" Content="{DynamicResource AI_RestoreDefaults}"
                            Height="30" Margin="8,0,0,0" Padding="10,0" Click="OnRestoreAllDefaultsClick"
                            ToolTip="{DynamicResource AI_RestoreAll_Desc}"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <RadioButton Style="{StaticResource AiTabButton}" GroupName="AiTabs" Tag="0" IsChecked="True"
                                 Content="{DynamicResource AI_TabAssistant}" Checked="OnTabButtonChecked"/>
                    <RadioButton Style="{StaticResource AiTabButton}" GroupName="AiTabs" Tag="1"
                                 Content="OpenAI" Checked="OnTabButtonChecked"/>
                    <RadioButton Style="{StaticResource AiTabButton}" GroupName="AiTabs" Tag="2"
                                 Content="Azure OpenAI" Checked="OnTabButtonChecked"/>
                    <RadioButton Style="{StaticResource AiTabButton}" GroupName="AiTabs" Tag="3"
                                 Content="OpenRouter" Checked="OnTabButtonChecked"/>
                    <RadioButton Style="{StaticResource AiTabButton}" GroupName="AiTabs" Tag="4"
                                 Content="{DynamicResource AI_TabClaude}" Checked="OnTabButtonChecked"/>
                    <RadioButton Style="{StaticResource AiTabButton}" GroupName="AiTabs" Tag="5"
                                 Content="{DynamicResource AI_TabCodex}" Checked="OnTabButtonChecked"/>
                    <RadioButton Style="{StaticResource AiTabButton}" GroupName="AiTabs" Tag="6"
                                 Content="{DynamicResource AI_TabClaudeCli}" Checked="OnTabButtonChecked"/>
                    <RadioButton Style="{StaticResource AiTabButton}" GroupName="AiTabs" Tag="7"
                                 Content="{DynamicResource AI_TabMicrosoft}" Checked="OnTabButtonChecked"/>
                </WrapPanel>
                <TabControl x:Name="MainTabControl">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>
                    <TabItem Header="{DynamicResource AI_TabAssistant}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="110"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource AI_PromptLabel}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="PromptTextBox"
                                     Grid.Row="1"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>

                            <DockPanel Grid.Row="2" Margin="0,14,0,8">
                                <TextBlock Text="{DynamicResource AI_ResultLabel}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                                <Button x:Name="CopyResultButton"
                                    Content="{DynamicResource AI_CopyResult}"
                                    Width="140"
                                    Height="30"
                                    Margin="12,0,0,0"
                                    DockPanel.Dock="Right"
                                    Click="OnCopyResultClick"
                                    IsEnabled="False"/>
                            </DockPanel>
                            <TabControl x:Name="ResultTabControl" Grid.Row="3">
                                <TabItem Header="{DynamicResource AI_TabResultHeader}">
                                    <Grid Background="White">
                                        <wv2:WebView2 x:Name="ResultWebView"
                                                      DefaultBackgroundColor="White"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </TabItem>

                    <!-- ══ OpenAI ══════════════════════════════════════ -->
                    <TabItem Header="OpenAI">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Margin="10" Padding="14" CornerRadius="8"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_OpenAIConfig}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <TextBlock Text="{DynamicResource AI_Auth}" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="Use apenas API Key para conectar ao OpenAI. Clique no link abaixo para criar ou gerenciar sua chave no painel da OpenAI."/>

                                <StackPanel>
                                    <TextBlock Text="{DynamicResource AI_TokenApiKey}" FontWeight="SemiBold"/>
                                    <PasswordBox x:Name="OpenAiApiKeyBox" Margin="0,6,0,4" Height="30"/>
                                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#555">
                                        <Run Text="{DynamicResource AI_OpenAIKeyLinkPre}"/>
                                        <Hyperlink Click="OnOpenAiApiKeyGuideClick"><Run Text="{DynamicResource AI_OpenAIKeyLink}"/></Hyperlink>
                                        <Run Text="."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                               Text="{DynamicResource AI_OpenAIKeyNote}"/>
                                </StackPanel>

                                <TextBlock Text="{DynamicResource AI_Endpoint}" FontWeight="SemiBold"/>
                                <TextBox x:Name="OpenAiEndpointBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_Model}" FontWeight="SemiBold"/>
                                <TextBox x:Name="OpenAiModelBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_TimeoutSeconds}" FontWeight="SemiBold"/>
                                <TextBox x:Name="OpenAiTimeoutBox" Margin="0,6,0,0" Height="30" Width="120" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ Azure OpenAI ═══════════════════════════════════ -->
                    <TabItem Header="Azure OpenAI">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Margin="10" Padding="14" CornerRadius="8"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_AzureConfig}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_AzureNote}"/>

                                <TextBlock Text="{DynamicResource AI_TokenApiKey}" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="AzureApiKeyBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_Endpoint}" FontWeight="SemiBold"/>
                                <TextBox x:Name="AzureEndpointBox" Margin="0,6,0,4" Height="30"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_AzureEndpointNote}"/>
                                <TextBlock Text="{DynamicResource AI_Model}" FontWeight="SemiBold"/>
                                <TextBox x:Name="AzureModelBox" Margin="0,6,0,4" Height="30"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_AzureModelNote}"/>
                                <TextBlock Text="{DynamicResource AI_TimeoutSeconds}" FontWeight="SemiBold"/>
                                <TextBox x:Name="AzureTimeoutBox" Margin="0,6,0,0" Height="30" Width="120" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ OpenRouter ══════════════════════════════════════ -->
                    <TabItem Header="OpenRouter">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Margin="10" Padding="14" CornerRadius="8"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_OpenRouterConfig}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <TextBlock Text="{DynamicResource AI_Token}" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="OpenRouterApiKeyBox" Margin="0,6,0,4" Height="30"/>
                                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#555">
                                    <Run Text="{DynamicResource AI_OpenRouterKeyLinkPre}"/>
                                    <Hyperlink Click="OnOpenRouterApiKeyGuideClick"><Run Text="{DynamicResource AI_OpenRouterKeyLink}"/></Hyperlink>
                                    <Run Text="."/>
                                </TextBlock>

                                <TextBlock Text="{DynamicResource AI_Endpoint}" FontWeight="SemiBold"/>
                                <TextBox x:Name="OpenRouterEndpointBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_Model}" FontWeight="SemiBold"/>
                                <TextBox x:Name="OpenRouterModelBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_TimeoutSeconds}" FontWeight="SemiBold"/>
                                <TextBox x:Name="OpenRouterTimeoutBox" Margin="0,6,0,0" Height="30" Width="120" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ Claude (API Cloud da Anthropic) ═══════════════ -->
                    <TabItem Header="Claude">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Margin="10" Padding="14" CornerRadius="8"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_ClaudeConfig}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_ClaudeNote}"/>

                                <TextBlock Text="{DynamicResource AI_TokenApiKey}" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="ClaudeApiKeyBox" Margin="0,6,0,4" Height="30"/>
                                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#555">
                                    <Run Text="{DynamicResource AI_ClaudeKeyLinkPre}"/>
                                    <Hyperlink Click="OnClaudeApiKeyGuideClick"><Run Text="{DynamicResource AI_ClaudeKeyLink}"/></Hyperlink>
                                    <Run Text="."/>
                                </TextBlock>

                                <TextBlock Text="{DynamicResource AI_Endpoint}" FontWeight="SemiBold"/>
                                <TextBox x:Name="ClaudeEndpointBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_Model}" FontWeight="SemiBold"/>
                                <TextBox x:Name="ClaudeModelBox" Margin="0,6,0,4" Height="30"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_ClaudeModelNote}"/>
                                <TextBlock Text="{DynamicResource AI_TimeoutSeconds}" FontWeight="SemiBold"/>
                                <TextBox x:Name="ClaudeTimeoutBox" Margin="0,6,0,0" Height="30" Width="120" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ Codex instalado na maquina (CLI local) ════════ -->
                    <TabItem Header="Codex">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Margin="10" Padding="14" CornerRadius="8"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_CodexConfig}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_CodexNote}"/>

                                <TextBlock Text="{DynamicResource AI_CliLocation}" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CodexLocationCombo" Width="240" HorizontalAlignment="Left"
                                          Margin="0,6,0,4" SelectionChanged="OnCodexLocationChanged">
                                    <ComboBoxItem Content="{DynamicResource AI_CliLocWindows}" Tag="win"/>
                                    <ComboBoxItem Content="{DynamicResource AI_CliLocWsl}" Tag="wsl"/>
                                </ComboBox>
                                <TextBlock x:Name="CodexLocationStatus" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"/>

                                <TextBlock Text="{DynamicResource AI_CodexCommand}" FontWeight="SemiBold"/>
                                <TextBox x:Name="CodexCommandBox" Margin="0,6,0,4" Height="30"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_CodexCommandNote}"/>

                                <!-- Como preparar a maquina: WSL + Codex CLI (copiaveis) -->
                                <Border Background="#FFF7E8" BorderBrush="#E8D39A" BorderThickness="1"
                                        CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                                    <Expander x:Name="CodexSetupExpander" IsExpanded="False" Foreground="#5A4A1E"
                                              Header="{DynamicResource AI_CodexSetupHead}" FontWeight="SemiBold">
                                      <StackPanel TextBlock.FontWeight="Normal" Margin="0,6,0,0">
                                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#5A4A1E">
                                            <Run Text="{DynamicResource AI_CodexStep1}"/>
                                            <Hyperlink Click="OnWslInstallGuideClick"><Run Text="{DynamicResource AI_CodexWslLink}"/></Hyperlink>
                                        </TextBlock>
                                        <TextBox x:Name="CodexWslCommandBox" IsReadOnly="True" Margin="0,4,0,0" Height="46"
                                                 FontFamily="Consolas" FontSize="12" Background="White"
                                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 Text="wsl --install -d Ubuntu&#10;wsl --set-default Ubuntu"/>
                                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#5A4A1E"
                                                   Text="{DynamicResource AI_CodexStep1Note}"/>

                                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#5A4A1E"
                                                   Text="{DynamicResource AI_CodexStep2}"/>
                                        <TextBox x:Name="CodexNodeCommandBox" IsReadOnly="True" Margin="0,4,0,0" Height="46"
                                                 FontFamily="Consolas" FontSize="12" Background="White"
                                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 Text="curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash -&#10;sudo apt-get install -y nodejs"/>

                                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#5A4A1E"
                                                   Text="{DynamicResource AI_CodexStep3}"/>
                                        <TextBox x:Name="CodexInstallCommandBox" IsReadOnly="True" Margin="0,4,0,0" Height="26"
                                                 FontFamily="Consolas" FontSize="12" Background="White"
                                                 Text="sudo npm install -g @openai/codex"/>

                                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#5A4A1E"
                                                   Text="{DynamicResource AI_CodexStep4}"/>
                                        <TextBox x:Name="CodexLoginCommandBox" IsReadOnly="True" Margin="0,4,0,0" Height="26"
                                                 FontFamily="Consolas" FontSize="12" Background="White"
                                                 Text="codex login"/>
                                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#5A4A1E"
                                                   Text="{DynamicResource AI_CodexLoginTip}"/>
                                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#5A4A1E">
                                            <Hyperlink Click="OnOpenAiAccountClick"><Run Text="{DynamicResource AI_CodexLoginOpenLink}"/></Hyperlink>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{DynamicResource AI_CodexCopySetup}" Width="180" Height="26"
                                                    Click="OnCodexCopySetupClick"/>
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#5A4A1E">
                                                <Hyperlink Click="OnCodexDocsClick"><Run Text="{DynamicResource AI_CodexDocsLink}"/></Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#5A4A1E">
                                            <Run Text="{DynamicResource AI_CodexWinPre}"/>
                                            <Hyperlink Click="OnCodexWindowsInstallClick"><Run Text="{DynamicResource AI_CodexWinLink}"/></Hyperlink>
                                        </TextBlock>
                                        <StackPanel Visibility="Collapsed">
                                        </StackPanel>
                                      </StackPanel>
                                    </Expander>
                                </Border>

                                <TextBlock Text="{DynamicResource AI_TimeoutSeconds}" FontWeight="SemiBold"/>
                                <TextBox x:Name="CodexTimeoutBox" Margin="0,6,0,10" Height="30" Width="120" HorizontalAlignment="Left"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="CodexTestButton" Content="{DynamicResource AI_CodexTest}"
                                            Width="170" Height="30" Click="OnCodexTestClick"/>
                                    <TextBlock x:Name="CodexTestResult" Margin="12,0,0,0" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Foreground="#555" MaxWidth="420"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ Claude Code instalado na maquina (CLI local) ══ -->
                    <TabItem Header="Claude Code">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Margin="10" Padding="14" CornerRadius="8"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_ClaudeCliConfig}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_ClaudeCliNote}"/>

                                <TextBlock Text="{DynamicResource AI_CliLocation}" FontWeight="SemiBold"/>
                                <ComboBox x:Name="ClaudeCliLocationCombo" Width="240" HorizontalAlignment="Left"
                                          Margin="0,6,0,4" SelectionChanged="OnClaudeCliLocationChanged">
                                    <ComboBoxItem Content="{DynamicResource AI_CliLocWindows}" Tag="win"/>
                                    <ComboBoxItem Content="{DynamicResource AI_CliLocWsl}" Tag="wsl"/>
                                </ComboBox>
                                <TextBlock x:Name="ClaudeCliLocationStatus" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"/>

                                <TextBlock Text="{DynamicResource AI_CodexCommand}" FontWeight="SemiBold"/>
                                <TextBox x:Name="ClaudeCliCommandBox" Margin="0,6,0,4" Height="30"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_ClaudeCliCommandNote}"/>

                                <Border Background="#FFF7E8" BorderBrush="#E8D39A" BorderThickness="1"
                                        CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                                    <Expander x:Name="ClaudeCliSetupExpander" IsExpanded="False" Foreground="#5A4A1E"
                                              Header="{DynamicResource AI_CodexSetupHead}" FontWeight="SemiBold">
                                      <StackPanel TextBlock.FontWeight="Normal" Margin="0,6,0,0">
                                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#5A4A1E"
                                                   Text="{DynamicResource AI_ClaudeCliStep1}"/>
                                        <TextBox x:Name="ClaudeCliInstallCommandBox" IsReadOnly="True" Margin="0,4,0,0" Height="26"
                                                 FontFamily="Consolas" FontSize="12" Background="White"
                                                 Text="npm install -g @anthropic-ai/claude-code"/>

                                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#5A4A1E"
                                                   Text="{DynamicResource AI_ClaudeCliStep2}"/>
                                        <TextBox x:Name="ClaudeCliLoginCommandBox" IsReadOnly="True" Margin="0,4,0,0" Height="26"
                                                 FontFamily="Consolas" FontSize="12" Background="White"
                                                 Text="claude"/>
                                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#5A4A1E"
                                                   Text="{DynamicResource AI_ClaudeCliLoginTip}"/>
                                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#5A4A1E">
                                            <Hyperlink Click="OnClaudeAccountClick"><Run Text="{DynamicResource AI_ClaudeCliLoginOpenLink}"/></Hyperlink>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{DynamicResource AI_CodexCopySetup}" Width="180" Height="26"
                                                    Click="OnClaudeCliCopySetupClick"/>
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#5A4A1E">
                                                <Hyperlink Click="OnClaudeCodeDocsClick"><Run Text="{DynamicResource AI_ClaudeCliDocsLink}"/></Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                      </StackPanel>
                                    </Expander>
                                </Border>

                                <TextBlock Text="{DynamicResource AI_TimeoutSeconds}" FontWeight="SemiBold"/>
                                <TextBox x:Name="ClaudeCliTimeoutBox" Margin="0,6,0,10" Height="30" Width="120" HorizontalAlignment="Left"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ClaudeCliTestButton" Content="{DynamicResource AI_ClaudeCliTest}"
                                            Width="190" Height="30" Click="OnClaudeCliTestClick"/>
                                    <TextBlock x:Name="ClaudeCliTestResult" Margin="12,0,0,0" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Foreground="#555" MaxWidth="420"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ Microsoft 365 / Entra ID (conta da empresa) ═══ -->
                    <TabItem Header="Microsoft 365">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Margin="10" Padding="14" CornerRadius="8"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_MsConfig}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_MsNote}"/>

                                <Border Background="#FFF7E8" BorderBrush="#E8D39A" BorderThickness="1"
                                        CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                                    <TextBlock Text="{DynamicResource AI_MsItRequirement}" FontSize="11"
                                               Foreground="#5A4A1E" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="{DynamicResource AI_MsTenant}" FontWeight="SemiBold"/>
                                <TextBox x:Name="MsTenantBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_MsClientId}" FontWeight="SemiBold"/>
                                <TextBox x:Name="MsClientIdBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_MsScope}" FontWeight="SemiBold"/>
                                <TextBox x:Name="MsScopeBox" Margin="0,6,0,4" Height="30"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_MsScopeNote}"/>

                                <TextBlock Text="{DynamicResource AI_Endpoint}" FontWeight="SemiBold"/>
                                <TextBox x:Name="MsEndpointBox" Margin="0,6,0,4" Height="30"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_MsEndpointNote}"/>

                                <TextBlock Text="{DynamicResource AI_TimeoutSeconds}" FontWeight="SemiBold"/>
                                <TextBox x:Name="MsTimeoutBox" Margin="0,6,0,12" Height="30" Width="120" HorizontalAlignment="Left"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="MsLoginButton" Content="{DynamicResource AI_MsLogin}"
                                            Width="230" Height="30" Click="OnMsLoginClick"/>
                                    <Button x:Name="MsTestButton" Content="{DynamicResource AI_MsTest}"
                                            Width="170" Height="30" Margin="8,0,0,0" Click="OnMsTestClick"/>
                                    <Button x:Name="MsSignOutButton" Content="{DynamicResource AI_MsSignOut}"
                                            Width="120" Height="30" Margin="8,0,0,0" Click="OnMsSignOutClick"/>
                                </StackPanel>

                                <TextBlock x:Name="MsStatusText" TextWrapping="Wrap" Foreground="#555"/>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Width="340">
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           Foreground="#555"
                           Text="{DynamicResource AI_ReadyStatus}"/>
                <ProgressBar x:Name="RequestProgressBar"
                             Height="14"
                             Margin="0,6,0,0"
                             Minimum="0"
                             Maximum="45"
                             Value="0"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="ProgressTextBlock"
                           Margin="0,4,0,0"
                           Foreground="#666"
                           Visibility="Collapsed"
                           Text="Tempo restante: 45s"/>
            </StackPanel>
            <Button x:Name="SaveConfigButton"
                    Width="150"
                    Height="34"
                    Margin="8,0,0,0"
                    Click="OnSaveConfigClick"
                    Content="{DynamicResource AI_SaveConfig}"/>
            <Button x:Name="GenerateButton"
                    Width="140"
                    Height="34"
                    Margin="8,0,0,0"
                    Click="OnGenerateClick"
                    Content="{DynamicResource AI_Execute}"/>
            <Button x:Name="ApplyButton"
                    Width="150"
                    Height="34"
                    Margin="8,0,0,0"
                    Click="OnApplyClick"
                    IsEnabled="False"
                    Content="{DynamicResource AI_Apply}"/>
            <Button Width="100"
                    Height="34"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="OnCloseClick"
                    Content="{DynamicResource AI_Close}"/>
        </DockPanel>
    </Grid>
</Window>
