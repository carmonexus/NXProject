<Window x:Class="NXProject.Views.CommunityAIWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource AI_WindowTitle}"
        Width="860"
        Height="680"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{DynamicResource AI_Title}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#2B579A"/>
                <TextBlock Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="#444"
                           Text="{DynamicResource AI_Intro}"/>
                <TextBlock Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="#555"
                           Text="{DynamicResource AI_SecretNote}"/>
            </StackPanel>

            <TabControl Grid.Row="1" Margin="0,0,0,14">
                    <TabItem Header="{DynamicResource AI_TabAssistant}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="110"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource AI_PromptLabel}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="PromptTextBox"
                                     Grid.Row="1"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>

                            <DockPanel Grid.Row="2" Margin="0,14,0,8">
                                <TextBlock Text="{DynamicResource AI_ResultLabel}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                                <Button x:Name="CopyResultButton"
                                    Content="{DynamicResource AI_CopyResult}"
                                    Width="140"
                                    Height="30"
                                    Margin="12,0,0,0"
                                    DockPanel.Dock="Right"
                                    Click="OnCopyResultClick"
                                    IsEnabled="False"/>
                            </DockPanel>
                            <TabControl x:Name="ResultTabControl" Grid.Row="3">
                                <TabItem Header="{DynamicResource AI_TabResultHeader}">
                                    <Grid Background="White">
                                        <wv2:WebView2 x:Name="ResultWebView"
                                                      DefaultBackgroundColor="White"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </TabItem>

                    <!-- ══ Geral ══════════════════════════════════════ -->
                    <TabItem Header="{DynamicResource AI_TabGeneral}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Padding="14" CornerRadius="8"
                                    BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource AI_DefaultProvider_Label}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource AI_DefaultProvider_Desc}"
                                               TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"/>
                                    <ComboBox x:Name="DefaultProviderCombo" Height="30" Width="240" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="OpenAI" Tag="OpenAI"/>
                                        <ComboBoxItem Content="Work IQ" Tag="WorkIQ"/>
                                        <ComboBoxItem Content="OpenRouter" Tag="OpenRouter"/>
                                    </ComboBox>

                                    <TextBlock Text="{DynamicResource AI_ScheduleMode_Label}" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,4"/>
                                    <TextBlock Text="{DynamicResource AI_ScheduleMode_Desc}"
                                               TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="CreateTasksCheck"
                                              Content="{DynamicResource AI_CreateTaskCheck}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Padding="14" CornerRadius="8"
                                    BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource AI_ContextRules}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="{DynamicResource AI_ProjectContextLabel}" FontWeight="SemiBold"/>
                                    <TextBox x:Name="ProjectContextTextBox" Margin="0,6,0,10" Height="92"
                                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="{DynamicResource AI_AllowedScope}" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555"
                                               Text="{DynamicResource AI_AllowedScope_Desc}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Tipos de acao com IA -->
                        <Border Padding="14" CornerRadius="8" Margin="0,12,0,0"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_ActionType_Label}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_ActionType_Desc}"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ActionTypeCombo" Grid.Column="0" Height="30"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="OnActionTypeSelectionChanged"/>
                                    <Button Grid.Column="1" Content="{DynamicResource AI_NewAction}" Width="64" Height="30" Margin="6,0,0,0" Click="OnNewActionClick"/>
                                    <Button Grid.Column="2" Content="{DynamicResource AI_DeleteAction}" Width="64" Height="30" Margin="6,0,0,0" Click="OnDeleteActionClick"/>
                                    <Button Grid.Column="3" Content="{DynamicResource AI_RestoreDefaults}" Width="120" Height="30" Margin="6,0,0,0" Click="OnRestoreDefaultActionsClick"/>
                                </Grid>

                                <TextBlock Text="{DynamicResource AI_ActionNameLabel}" FontWeight="SemiBold"/>
                                <TextBox x:Name="ActionNameBox" Margin="0,4,0,8" Height="28"
                                         TextChanged="OnActionFieldChanged"/>
                                <CheckBox x:Name="ActionCreatesTasksCheck" Content="{DynamicResource AI_ActionCreatesTasks}"
                                          Margin="0,0,0,8" Click="OnActionFieldChanged"/>
                                <TextBlock Text="{DynamicResource AI_ActionPromptLabel}" FontWeight="SemiBold"/>
                                <TextBox x:Name="ActionPromptBox" Margin="0,4,0,8" Height="150"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                         TextChanged="OnActionFieldChanged"/>

                                <TextBlock Text="{DynamicResource AI_AnalysisTaskLimitLabel}" FontWeight="SemiBold"/>
                                <TextBox x:Name="AnalysisTaskLimitBox" Margin="0,4,0,0" Height="28" Width="120"
                                         HorizontalAlignment="Left"/>
                                <TextBlock Text="{DynamicResource AI_AnalysisTaskLimitDesc}"
                                           TextWrapping="Wrap" Foreground="#555" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ OpenAI ══════════════════════════════════════ -->
                    <TabItem Header="OpenAI">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Margin="10" Padding="14" CornerRadius="8"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_OpenAIConfig}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <TextBlock Text="{DynamicResource AI_Auth}" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="Use apenas API Key para conectar ao OpenAI. Clique no link abaixo para criar ou gerenciar sua chave no painel da OpenAI."/>

                                <StackPanel>
                                    <TextBlock Text="{DynamicResource AI_TokenApiKey}" FontWeight="SemiBold"/>
                                    <PasswordBox x:Name="OpenAiApiKeyBox" Margin="0,6,0,4" Height="30"/>
                                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#555">
                                        <Run Text="{DynamicResource AI_OpenAIKeyLinkPre}"/>
                                        <Hyperlink Click="OnOpenAiApiKeyGuideClick"><Run Text="{DynamicResource AI_OpenAIKeyLink}"/></Hyperlink>
                                        <Run Text="."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                               Text="{DynamicResource AI_OpenAIKeyNote}"/>
                                </StackPanel>

                                <TextBlock Text="{DynamicResource AI_Endpoint}" FontWeight="SemiBold"/>
                                <TextBox x:Name="OpenAiEndpointBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_Model}" FontWeight="SemiBold"/>
                                <TextBox x:Name="OpenAiModelBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_TimeoutSeconds}" FontWeight="SemiBold"/>
                                <TextBox x:Name="OpenAiTimeoutBox" Margin="0,6,0,0" Height="30" Width="120" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ Work IQ ══════════════════════════════════════ -->
                    <TabItem Header="Work IQ">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Margin="10" Padding="14" CornerRadius="8"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_WorkIQConfig}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                                           Text="{DynamicResource AI_WorkIQNote}"/>

                                <TextBlock Text="{DynamicResource AI_TokenApiKey}" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="WorkIqApiKeyBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_Endpoint}" FontWeight="SemiBold"/>
                                <TextBox x:Name="WorkIqEndpointBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_Model}" FontWeight="SemiBold"/>
                                <TextBox x:Name="WorkIqModelBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_TimeoutSeconds}" FontWeight="SemiBold"/>
                                <TextBox x:Name="WorkIqTimeoutBox" Margin="0,6,0,0" Height="30" Width="120" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ OpenRouter ══════════════════════════════════════ -->
                    <TabItem Header="OpenRouter">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Margin="10" Padding="14" CornerRadius="8"
                                BorderBrush="#D9E1EA" BorderThickness="1" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AI_OpenRouterConfig}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <TextBlock Text="{DynamicResource AI_Token}" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="OpenRouterApiKeyBox" Margin="0,6,0,4" Height="30"/>
                                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#555">
                                    <Run Text="{DynamicResource AI_OpenRouterKeyLinkPre}"/>
                                    <Hyperlink Click="OnOpenRouterApiKeyGuideClick"><Run Text="{DynamicResource AI_OpenRouterKeyLink}"/></Hyperlink>
                                    <Run Text="."/>
                                </TextBlock>

                                <TextBlock Text="{DynamicResource AI_Endpoint}" FontWeight="SemiBold"/>
                                <TextBox x:Name="OpenRouterEndpointBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_Model}" FontWeight="SemiBold"/>
                                <TextBox x:Name="OpenRouterModelBox" Margin="0,6,0,10" Height="30"/>
                                <TextBlock Text="{DynamicResource AI_TimeoutSeconds}" FontWeight="SemiBold"/>
                                <TextBox x:Name="OpenRouterTimeoutBox" Margin="0,6,0,0" Height="30" Width="120" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Width="340">
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           Foreground="#555"
                           Text="{DynamicResource AI_ReadyStatus}"/>
                <ProgressBar x:Name="RequestProgressBar"
                             Height="14"
                             Margin="0,6,0,0"
                             Minimum="0"
                             Maximum="45"
                             Value="0"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="ProgressTextBlock"
                           Margin="0,4,0,0"
                           Foreground="#666"
                           Visibility="Collapsed"
                           Text="Tempo restante: 45s"/>
            </StackPanel>
            <Button x:Name="SaveConfigButton"
                    Width="150"
                    Height="34"
                    Margin="8,0,0,0"
                    Click="OnSaveConfigClick"
                    Content="{DynamicResource AI_SaveConfig}"/>
            <Button x:Name="GenerateButton"
                    Width="140"
                    Height="34"
                    Margin="8,0,0,0"
                    Click="OnGenerateClick"
                    Content="{DynamicResource AI_Execute}"/>
            <Button x:Name="ApplyButton"
                    Width="150"
                    Height="34"
                    Margin="8,0,0,0"
                    Click="OnApplyClick"
                    IsEnabled="False"
                    Content="{DynamicResource AI_Apply}"/>
            <Button Width="100"
                    Height="34"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="OnCloseClick"
                    Content="{DynamicResource AI_Close}"/>
        </DockPanel>
    </Grid>
</Window>
