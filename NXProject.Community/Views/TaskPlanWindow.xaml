<Window x:Class="NXProject.Views.TaskPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TaskPlan_Title}"
        Width="1100" Height="640"
        MinWidth="820" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource TaskPlan_Title}"
                   FontSize="18" FontWeight="SemiBold" Foreground="#2B579A"/>

        <!-- Faixa estilo Excel: menu Arquivo + barra de ícones -->
        <Border Grid.Row="1" Background="#F3F6F4" BorderBrush="#D5DDD7" BorderThickness="1"
                CornerRadius="4" Padding="8,6" Margin="0,10,0,8">
            <WrapPanel Orientation="Horizontal">
                <!-- Menu Arquivo: ações de baixa frequência -->
                <Menu VerticalAlignment="Center" Background="Transparent" Margin="0,0,6,2">
                    <MenuItem Padding="10,4" Background="#107C41" Foreground="White" FontWeight="SemiBold">
                        <MenuItem.Header>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="&#x1F4C1;" FontSize="15" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource TaskPlan_FileMenu}" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Header="{DynamicResource TaskPlan_New}" Click="OnNewClick"
                                  ToolTip="{DynamicResource TaskPlan_NewTip}" Foreground="#222">
                            <MenuItem.Icon><TextBlock Text="&#x1F4C4;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource TaskPlan_Open}" Click="OnOpenClick" Foreground="#222">
                            <MenuItem.Icon><TextBlock Text="&#x1F4C2;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource TaskPlan_Reload}" Click="OnReloadClick" Foreground="#222">
                            <MenuItem.Icon><TextBlock Text="&#x1F504;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{DynamicResource TaskPlan_Save}" Click="OnSaveClick" Foreground="#222">
                            <MenuItem.Icon><TextBlock Text="&#x1F4BE;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource TaskPlan_SaveAs}" Click="OnSaveAsClick" Foreground="#222">
                            <MenuItem.Icon><TextBlock Text="&#x1F4C4;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{DynamicResource TaskPlan_Settings}" Click="OnSettingsClick" Foreground="#222">
                            <MenuItem.Icon><TextBlock Text="&#x2699;"/></MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <!-- Salvar rápido -->
                <Button Width="60" Height="46" Margin="0,0,6,2" Click="OnSaveClick"
                        Background="#1B5E20" ToolTip="{DynamicResource TaskPlan_Save}">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#x1F4BE;" FontSize="14" VerticalAlignment="Center"/>
                            <Border Background="#107C41" CornerRadius="2" Margin="3,0,0,0" Padding="3,0">
                                <TextBlock Text="X" FontSize="11" FontWeight="Bold" Foreground="White"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource TaskPlan_CapSave}" FontSize="10" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Fill="#C9D3CC" Margin="4,2,10,2"/>

                <!-- Ações DevOps/cronograma: ícones com legenda (como no ribbon do Excel) -->
                <Button Width="60" Height="46" Margin="0,0,4,2" Click="OnFetchDevOpsClick"
                        Background="#2B579A" ToolTip="{DynamicResource TaskPlan_FetchDevOpsTip}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#x1F50D;" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TaskPlan_CapFetch}" FontSize="10" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Width="60" Height="46" Margin="0,0,4,2" Click="OnMergeScheduleClick"
                        Background="#00695C" ToolTip="{DynamicResource TaskPlan_MergeTip}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#x1F500;" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TaskPlan_CapMerge}" FontSize="10" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Width="60" Height="46" Margin="0,0,4,2" Click="OnLoadTaskClick"
                        Background="#0277BD" ToolTip="{DynamicResource TaskPlan_LoadTaskTip}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#x1F4CB;" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TaskPlan_CapLoadTask}" FontSize="10" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Width="64" Height="46" Margin="0,0,4,2" Click="OnOpenSelectedTfsClick"
                        Background="#455A64" ToolTip="{DynamicResource TaskPlan_OpenSelTfsTip}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#x1F517;" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TaskPlan_CapOpenSelTfs}" FontSize="9" Foreground="White"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Width="64" Height="46" Margin="0,0,4,2" Click="OnReadSelectedTfsClick"
                        Background="#01579B" ToolTip="{DynamicResource TaskPlan_ReadSelTfsTip}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#x2B07;" FontSize="14" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TaskPlan_CapReadSelTfs}" FontSize="9" Foreground="White"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Width="64" Height="46" Margin="0,0,4,2" Click="OnSaveSelectedTfsClick"
                        Background="#1B5E20" ToolTip="{DynamicResource TaskPlan_SaveSelTfsTip}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#x2B06;" FontSize="14" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TaskPlan_CapSaveSelTfs}" FontSize="9" Foreground="White"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Width="60" Height="46" Margin="0,0,4,2" Click="OnApplyScheduleClick"
                        Background="#6A1B9A" ToolTip="{DynamicResource TaskPlan_ApplyScheduleTip}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#x1F4C6;" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TaskPlan_CapApply}" FontSize="10" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Width="60" Height="46" Margin="0,0,4,2" Click="OnLoadAllClick"
                        Background="#B26A00" ToolTip="{DynamicResource TaskPlan_LoadAllTip}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#x1F4E5;" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TaskPlan_CapLoadAll}" FontSize="10" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Height="46" Width="52" Margin="0,0,4,2" Click="OnClearFiltersClick"
                        ToolTip="{DynamicResource TaskPlan_ClearFilters}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#x1F9F9;" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TaskPlan_CapClear}" FontSize="9"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ReapplyFilterBtn" Height="46" Width="52" Margin="0,0,4,2"
                        Click="OnReapplyFilterClick"
                        ToolTip="{DynamicResource TaskPlan_ReapplyFilterTip}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#x1F501;" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TaskPlan_CapReapply}" FontSize="9"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Height="46" Width="52" Margin="0,0,4,2" Click="OnSaveFilterClick"
                        ToolTip="{DynamicResource TaskPlan_SaveFilterTip}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#x1F4BE;" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TaskPlan_CapSaveFilter}" FontSize="9"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="IdVisibilityBtn" Height="46" Width="52" Margin="0,0,4,2" Click="OnIdVisibilityClick"
                        ToolTip="{DynamicResource TaskPlan_IdVisTip}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="IdVisibilityIcon" Text="ID" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource TaskPlan_CapIds}" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="IdVisAlwaysItem" Header="{DynamicResource TaskPlan_IdVisAlways}"
                                      IsCheckable="True" IsChecked="True" Click="OnIdVisModeClick" Tag="Always"/>
                            <MenuItem x:Name="IdVisHiddenItem" Header="{DynamicResource TaskPlan_IdVisHidden}"
                                      IsCheckable="True" Click="OnIdVisModeClick" Tag="Hidden"/>
                            <MenuItem x:Name="IdVisInternalItem" Header="{DynamicResource TaskPlan_IdVisInternal}"
                                      IsCheckable="True" Click="OnIdVisModeClick" Tag="OnlyInternal"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource TaskPlan_IdVisSave}" Click="OnIdVisSaveClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <CheckBox x:Name="EnableAiCheckBox"
                          Content="{DynamicResource TaskPlan_EnableAI}"
                          IsChecked="False"
                          VerticalAlignment="Center"
                          Margin="8,0,4,2"
                          Checked="OnEnableAiChanged"
                          Unchecked="OnEnableAiChanged"
                          ToolTip="{DynamicResource TaskPlan_EnableAITip}"/>
                <CheckBox x:Name="OpenTasksOnlyCheckBox"
                          Content="{DynamicResource TaskPlan_OpenTasksOnly}"
                          IsChecked="False"
                          VerticalAlignment="Center"
                          Margin="8,0,4,2"
                          Checked="OnOpenTasksOnlyChanged"
                          Unchecked="OnOpenTasksOnlyChanged"
                          ToolTip="{DynamicResource TaskPlan_OpenTasksOnlyTip}"/>
                <CheckBox x:Name="AiOnlyCheckBox"
                          Content="{DynamicResource TaskPlan_AiOnly}"
                          IsChecked="False"
                          VerticalAlignment="Center"
                          Margin="8,0,4,2"
                          Checked="OnAiOnlyChanged"
                          Unchecked="OnAiOnlyChanged"
                          ToolTip="{DynamicResource TaskPlan_AiOnlyTip}"/>
                <!-- Indicador "IA em execução" (visível enquanto Incluir/Consultar rodam) -->
                <StackPanel x:Name="AiRunningPanel" Orientation="Horizontal" Visibility="Collapsed"
                            VerticalAlignment="Center" Margin="12,0,4,2">
                    <TextBlock Text="&#x1F916;" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ProgressBar IsIndeterminate="True" Width="46" Height="10" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Main_AiRunning}" FontSize="11" FontWeight="SemiBold"
                               Foreground="#2B579A" VerticalAlignment="Center"/>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- Linha de filtros e caminho do arquivo (abaixo da faixa de ícones) -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="2,0,0,8">
            <TextBlock Text="{DynamicResource TaskPlan_EpicFilter}" VerticalAlignment="Center" Margin="0,0,6,2" FontSize="12" Foreground="#555"/>
            <ComboBox x:Name="EpicFilterCombo" Width="200" Height="28" VerticalContentAlignment="Center"
                      FontSize="12" Margin="0,0,10,2" SelectionChanged="OnEpicFilterChanged"/>
            <TextBlock Text="{DynamicResource TaskPlan_FeatureFilter}" VerticalAlignment="Center" Margin="0,0,6,2" FontSize="12" Foreground="#555"/>
            <ComboBox x:Name="FeatureFilterCombo" Width="200" Height="28" VerticalContentAlignment="Center"
                      FontSize="12" Margin="0,0,10,2" SelectionChanged="OnFeatureFilterChanged"/>
            <TextBlock x:Name="PathText" VerticalAlignment="Center" Margin="4,0,0,2"
                       FontSize="11" Foreground="#666" TextTrimming="CharacterEllipsis" MaxWidth="520"
                       MouseLeftButtonUp="OnPathTextClick"/>
        </WrapPanel>

        <!-- Painel de IA (visível com "Ativar IA"): cola a lista da reunião e inclui tasks na planilha -->
        <Border x:Name="AiIncludePanel" Grid.Row="3" Visibility="Collapsed"
                Background="#F5F7FA" BorderBrush="#D0D7E0" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource TaskPlan_AiIncludeTitle}"
                           FontWeight="SemiBold" FontSize="12" Foreground="#2B579A" Margin="0,0,0,4"/>
                <TextBox x:Name="AiIncludeInputBox" Grid.Row="1" Grid.Column="0"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120"
                         VerticalScrollBarVisibility="Auto" FontSize="12"
                         ToolTip="{DynamicResource TaskPlan_AiIncludeInputTip}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                    <Button x:Name="AiIncludeSendBtn"
                            Content="{DynamicResource TaskPlan_AiIncludeSend}"
                            Width="130" Height="32"
                            Click="OnAiIncludeClick"/>
                    <Button x:Name="AiFindBtn"
                            Content="{DynamicResource TaskPlan_AiFind}"
                            Width="130" Height="32" Margin="0,6,0,0"
                            ToolTip="{DynamicResource TaskPlan_AiFindTip}"
                            Click="OnAiFindClick"/>
                </StackPanel>
                <TextBox x:Name="AiIncludeLogBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                         IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" MinHeight="0"
                         VerticalScrollBarVisibility="Auto" FontSize="11" Foreground="#444"
                         BorderThickness="0" Background="Transparent" Margin="0,6,0,0"
                         Visibility="Collapsed"/>
            </Grid>
        </Border>

        <DataGrid x:Name="PlanGrid" Grid.Row="4"
                  AutoGenerateColumns="True"
                  AutoGeneratedColumns="OnColumnsGenerated"
                  PreviewMouseLeftButtonDown="OnGridPreviewMouseDown"
                  PreviewMouseLeftButtonUp="OnGridPreviewMouseUp"
                  PreviewMouseRightButtonDown="OnGridPreviewMouseRightDown"
                  CanUserAddRows="True" CanUserDeleteRows="True"
                  CanUserReorderColumns="True" CanUserSortColumns="True"
                  GridLinesVisibility="All" HeadersVisibility="All"
                  RowHeaderWidth="38" RowHeight="24" FontSize="12"
                  LoadingRow="OnLoadingRow"
                  InitializingNewItem="OnInitializingNewItem"
                  AlternatingRowBackground="#F7F9FC"
                  SelectionUnit="CellOrRowHeader"
                  SelectionMode="Extended"
                  SelectedCellsChanged="OnSelectedCellsChanged"
                  ClipboardCopyMode="ExcludeHeader"
                  PreviewKeyDown="OnGridPreviewKeyDown"
                  BorderBrush="#D0D7E2" BorderThickness="1">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource TaskPlan_Undo}" InputGestureText="Ctrl+Z" Click="OnUndoClick"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource TaskPlan_Copy}" InputGestureText="Ctrl+C" Click="OnCopyClick"/>
                    <MenuItem Header="{DynamicResource TaskPlan_Paste}" InputGestureText="Ctrl+V" Click="OnPasteClick"/>
                    <MenuItem Header="{DynamicResource TaskPlan_FillDown}" InputGestureText="Ctrl+D" Click="OnFillDownClick"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource TaskPlan_ViewInSchedule}" Click="OnViewInScheduleClick"/>
                    <MenuItem Header="{DynamicResource TaskPlan_OpenInTfs}" Click="OnOpenInTfsClick"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource TaskPlan_InsertRowAbove}" Click="OnInsertRowAboveClick"/>
                    <MenuItem Header="{DynamicResource TaskPlan_InsertRowBelow}" Click="OnInsertRowBelowClick"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource TaskPlan_CellColor}">
                        <MenuItem Header="{DynamicResource TaskPlan_ColorYellow}" Tag="#FFF2CC" Click="OnCellColorClick">
                            <MenuItem.Icon><Border Background="#FFF2CC" BorderBrush="#999" BorderThickness="1" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource TaskPlan_ColorGreen}" Tag="#C6EFCE" Click="OnCellColorClick">
                            <MenuItem.Icon><Border Background="#C6EFCE" BorderBrush="#999" BorderThickness="1" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource TaskPlan_ColorBlue}" Tag="#BDD7EE" Click="OnCellColorClick">
                            <MenuItem.Icon><Border Background="#BDD7EE" BorderBrush="#999" BorderThickness="1" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource TaskPlan_ColorRed}" Tag="#FFC7CE" Click="OnCellColorClick">
                            <MenuItem.Icon><Border Background="#FFC7CE" BorderBrush="#999" BorderThickness="1" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource TaskPlan_ColorOrange}" Tag="#FCE4D6" Click="OnCellColorClick">
                            <MenuItem.Icon><Border Background="#FCE4D6" BorderBrush="#999" BorderThickness="1" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource TaskPlan_ColorGray}" Tag="#D9D9D9" Click="OnCellColorClick">
                            <MenuItem.Icon><Border Background="#D9D9D9" BorderBrush="#999" BorderThickness="1" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource TaskPlan_ColorPurple}" Tag="#E4DFEC" Click="OnCellColorClick">
                            <MenuItem.Icon><Border Background="#E4DFEC" BorderBrush="#999" BorderThickness="1" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{DynamicResource TaskPlan_ColorNone}" Tag="" Click="OnCellColorClick"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource TaskPlan_CopyColor}" Click="OnCopyCellColorClick"/>
                    <MenuItem Header="{DynamicResource TaskPlan_PasteColor}" Click="OnPasteCellColorClick"/>
                    <MenuItem Header="{DynamicResource TaskPlan_ClearCells}" Click="OnClearCellsClick"/>
                    <MenuItem Header="{DynamicResource TaskPlan_DeleteRows}" Click="OnDeleteRowsClick"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource TaskPlan_FitRowHeight}" Click="OnFitRowHeightClick"/>
                    <MenuItem Header="{DynamicResource TaskPlan_FitAll}" Click="OnFitAllClick"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <Grid Grid.Row="5" Margin="2,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ActiveFilterText" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,4"
                       FontSize="11" FontWeight="SemiBold" Foreground="#B26A00"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="CellRefText" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       FontSize="12" FontWeight="SemiBold" Foreground="#2B579A"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <ProgressBar x:Name="MergeProgress" Width="180" Height="14" Margin="0,0,10,0"
                             VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,16,0"
                           FontSize="12" Foreground="#2E7D32"/>
            </StackPanel>
            <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource TaskPlan_Close}" Width="90" Height="30"
                    Margin="10,0,0,0" IsCancel="True" Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>
