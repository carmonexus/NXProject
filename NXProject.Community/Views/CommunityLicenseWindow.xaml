<Window x:Class="NXProject.Views.CommunityLicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lic_Title}"
        Width="700"
        Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Closing="OnWindowClosing"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Lic_Header}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#2B579A"/>
            <TextBlock Text="{DynamicResource Lic_Subtitle}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="#444"/>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="8"
                Background="#F8FAFC"
                Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Lic_Company}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource Lic_Contact}"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="{DynamicResource Lic_SummaryHeader}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{DynamicResource Lic_P1}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P2}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P3}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P4}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P5}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P6}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_Scope}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_P7}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Lic_AcceptNote}" TextWrapping="Wrap" Margin="0,8,0,0" FontStyle="Italic" Foreground="#555"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{DynamicResource Lic_Exit}"
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="OnDeclineClick"/>
            <Button Content="{DynamicResource Lic_AcceptBtn}"
                    Width="160"
                    Height="32"
                    IsDefault="True"
                    Click="OnAcceptClick"/>
        </StackPanel>
    </Grid>
</Window>
