<Window x:Class="NXProject.Views.TramiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource Tramite_Title}"
        Width="780" Height="620" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="14" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" Text="{DynamicResource Tramite_History}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1">
            <wv2:WebView2 x:Name="HistoryView" DefaultBackgroundColor="White"/>
        </Border>

        <TextBlock Grid.Row="3" Text="{DynamicResource Tramite_New}" FontWeight="SemiBold" Margin="0,10,0,4"/>
        <Border Grid.Row="4" BorderBrush="#DDD" BorderThickness="1">
            <wv2:WebView2 x:Name="EditorView" DefaultBackgroundColor="White"/>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#666" FontSize="11" Margin="0,0,12,0"/>
            <Button Content="{DynamicResource Tramite_Register}" Width="150" Height="30" IsDefault="True" Click="OnRegisterClick"/>
            <Button Content="{DynamicResource Desc_Cancel}" Width="90" Height="30" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
