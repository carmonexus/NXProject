<Window x:Class="NXProject.Views.ScheduleUsageHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SU_Title}"
        Width="860"
        Height="680"
        MinWidth="640"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource SU_Title}"
                       FontSize="24" FontWeight="SemiBold" Foreground="#2B579A"/>
            <TextBlock Text="{DynamicResource SU_Sub}"
                       Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#444"/>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="8"
                Background="#F8FAFC" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="{DynamicResource SU_1H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource SU_1P}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_1a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_1b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_1c}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_1d}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_1e}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <TextBlock Text="{DynamicResource SU_2H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource SU_2P}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_2a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_2b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_2c}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_2d}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <TextBlock Text="{DynamicResource SU_3H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource SU_3P}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_3a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_3b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_3c}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_3d}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_3e}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <TextBlock Text="{DynamicResource SU_4H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource SU_4P}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_4a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_4b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_4c}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <TextBlock Text="{DynamicResource SU_5H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource SU_5P}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_5a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_5b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_5c}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_5d}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_5e}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_5f}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <TextBlock Text="{DynamicResource SU_6H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource SU_6P}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_6a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_6b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_6c}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_6d}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_6e}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_6f}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_6g}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <TextBlock Text="{DynamicResource SU_7H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource SU_7P}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_7a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_7b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_7c}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_7d}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_7e}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_7f}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <TextBlock Text="{DynamicResource SU_8H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource SU_8P}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_8a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_8b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_8c}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <TextBlock Text="{DynamicResource SU_9H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource SU_9P}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_9a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_9b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_9c}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_9d}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <TextBlock Text="{DynamicResource SU_10H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource SU_10P}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_10a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_10b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_10c}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_10d}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_10e}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_10f}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_10g}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <TextBlock Text="{DynamicResource SU_11H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource SU_11P}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_11a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_11b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_11c}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource SU_11d}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <Border Background="#FFF7E8" BorderBrush="#E8D39A" BorderThickness="1"
                            CornerRadius="6" Padding="12" Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource SU_Tip}" TextWrapping="Wrap" Foreground="#444"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource SU_Close}" Width="100" Height="30"
                    IsDefault="True" IsCancel="True" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
