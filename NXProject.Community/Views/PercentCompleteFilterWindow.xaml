<Window x:Class="NXProject.Views.PercentCompleteFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PctFilter_Title}"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource PctFilter_Title}"
                       FontSize="18" FontWeight="SemiBold" Foreground="#2B579A"/>
            <TextBlock Text="{DynamicResource PctFilter_Subtitle}"
                       Margin="0,4,0,0" Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource PctFilter_Min}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="MinBox"
                         Height="30"
                         Padding="8,4"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource PctFilter_Max}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="MaxBox"
                         Height="30"
                         Padding="8,4"
                         VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <CheckBox Grid.Row="2"
                  x:Name="ActiveOnlyCheck"
                  Content="{DynamicResource PctFilter_ActiveOnly}"
                  Margin="0,4,0,10"
                  VerticalAlignment="Top"
                  Checked="OnActiveOnlyChanged"
                  Unchecked="OnActiveOnlyChanged"/>

        <GroupBox Grid.Row="3"
                  Header="{DynamicResource PctFilter_RefDate}"
                  Margin="0,2,0,8"
                  Padding="8,6">
            <StackPanel>
                <TextBox x:Name="ReferenceDateBox"
                         Height="28"
                         Padding="8,3"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,8"/>
                <RadioButton x:Name="DateAnyRadio"
                             Content="{DynamicResource PctFilter_NoDateFilter}"
                             GroupName="DateFilter"
                             IsChecked="True"
                             Margin="0,0,0,4"/>
                <RadioButton x:Name="DateStartTodayRadio"
                             Content="{DynamicResource PctFilter_StartAfter}"
                             GroupName="DateFilter"
                             Margin="0,0,0,4"/>
                <RadioButton x:Name="DateFinishTodayRadio"
                             Content="{DynamicResource PctFilter_FinishBefore}"
                             GroupName="DateFilter"/>
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="4"
                   x:Name="ErrorText"
                   Foreground="#B00020"
                   FontSize="11"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource PctFilter_Clear}" Width="80" Height="30" Margin="0,0,8,0" Click="OnClearClick"/>
            <Button Content="{DynamicResource PctFilter_Cancel}" Width="90" Height="30" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="{DynamicResource PctFilter_Apply}" Width="90" Height="30" IsDefault="True" Click="OnApplyClick"/>
        </StackPanel>
    </Grid>
</Window>
