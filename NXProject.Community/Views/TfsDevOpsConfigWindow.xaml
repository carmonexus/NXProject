<Window x:Class="NXProject.Views.TfsDevOpsConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Cfg_Title}"
        Width="700" Height="680" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="White">

    <Border Padding="24,20,24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Cfg_Title}"
                           FontSize="20" FontWeight="SemiBold" Foreground="#2B579A"/>
                <TextBlock Text="{DynamicResource Cfg_Subtitle}"
                           FontSize="12" Foreground="#666" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- ══ Conexão ══════════════════════════════════════ -->
                <Border Background="#F0F4FA" BorderBrush="#C5D5EA" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Cfg_ConnSection}"
                                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" Foreground="#2B579A"/>

                        <TextBlock Text="{DynamicResource Cfg_OrgUrl}" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                        <TextBox x:Name="OrgUrlBox" Height="28" Padding="6,4" FontSize="12"
                                 ToolTip="{DynamicResource Cfg_OrgUrlTip}"/>

                        <TextBlock Text="{DynamicResource Cfg_TeamProject}" FontSize="11" Foreground="#555" Margin="0,10,0,3"/>
                        <TextBox x:Name="ProjectBox" Height="28" Padding="6,4" FontSize="12"
                                 ToolTip="{DynamicResource Cfg_TeamProjectTip}"/>

                        <TextBlock Text="{DynamicResource Cfg_Pat}" FontSize="11" Foreground="#555" Margin="0,10,0,3"/>
                        <PasswordBox x:Name="PatBox" Height="28" Padding="6,4" FontSize="12"/>
                        <CheckBox x:Name="RememberTokenCheck"
                                  Content="{DynamicResource Cfg_RememberToken}"
                                  FontSize="11" Foreground="#444" Margin="0,6,0,0"/>

                        <Border Background="#FFF7E8" BorderBrush="#E8D39A" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Cfg_PatScopesTitle}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#7A5C00"/>
                                <TextBlock Text="{DynamicResource Cfg_PatScopesSchedule}"
                                           FontSize="11" Foreground="#5A5A5A" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="{DynamicResource Cfg_PatScopesPeople}"
                                           FontSize="11" Foreground="#5A5A5A" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="EnableOrgDiscoveryCheck"
                                  Content="{DynamicResource Cfg_EnableOrgDiscovery}"
                                  ToolTip="{DynamicResource Cfg_EnableOrgDiscoveryTip}"
                                  FontSize="11" Foreground="#444" Margin="0,10,0,0"/>

                        <Border Background="#EEF4FB" BorderBrush="#B8D0EC" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Cfg_BacklogTitle}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#1F4E8C"/>
                                <TextBlock Text="{DynamicResource Cfg_BacklogNote}"
                                           FontSize="11" Foreground="#5A5A5A" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="{DynamicResource Cfg_BacklogPath}"
                                           FontSize="11" FontStyle="Italic" Foreground="#5A5A5A" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ Portfólio ══════════════════════════════════════ -->
                <Border Background="#EEF4FB" BorderBrush="#B8D0EC" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Cfg_PortfolioSection}"
                                       FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="#2B579A"/>
                            <Button Grid.Column="1" x:Name="ManageListButton"
                                    Content="{DynamicResource Imp_ManagePortfolio}"
                                    Height="26" Padding="10,2" FontSize="11"
                                    Click="OnManageListClick"
                                    ToolTip="{DynamicResource Imp_ManageTip}"/>
                        </Grid>
                        <TextBlock x:Name="ListPathLabel"
                                   FontSize="10" Foreground="#888"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{DynamicResource Imp_NoPortfolio}"/>
                    </StackPanel>
                </Border>

                <!-- ══ Calendário ══════════════════════════════════════ -->
                <Border Background="#F5F9F5" BorderBrush="#B5D5B5" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Cfg_CalendarLabel}"
                                   FontSize="12" Foreground="#444" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" x:Name="OpenCalendarButton"
                                Content="{DynamicResource Imp_Calendar}"
                                Height="28" Padding="10,4" FontSize="11"
                                Click="OnOpenCalendarClick"/>
                    </Grid>
                </Border>

                <!-- Campos avançados -->
                <Border Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1"
                        CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Cfg_AdvancedFields}" FontWeight="SemiBold" FontSize="13" Foreground="#2B579A" Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource Cfg_FieldNamesHint}"
                               FontSize="11" Foreground="#666" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Cfg_EffortField}" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                            <TextBox x:Name="EffortFieldBox" Height="26" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Cfg_StartField}" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                            <TextBox x:Name="StartFieldBox" Height="26" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{DynamicResource Cfg_FinishField}" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                            <TextBox x:Name="FinishFieldBox" Height="26" Padding="6,3"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Cfg_PercAlocField}" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                            <TextBox x:Name="PercAlocFieldBox" Height="26" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Cfg_PercConclusaoField}" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                            <TextBox x:Name="PercConclusaoFieldBox" Height="26" Padding="6,3"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Cfg_SyncVersionField}" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                            <TextBox x:Name="SyncVersionFieldBox" Height="26" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Cfg_SyncNameField}" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                            <TextBox x:Name="SyncNameFieldBox" Height="26" Padding="6,3"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource Cfg_FixedStartTag}" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                        <TextBox x:Name="FixedStartTagBox" Height="26" Padding="6,3" Width="220" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource Cfg_TaskPlanFile}" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TaskPlanFileBox" Grid.Column="0" Height="26" Padding="6,3"/>
                            <Button x:Name="TaskPlanFileBrowse" Grid.Column="1" Content="..." Width="32" Height="26"
                                    Margin="6,0,0,0" Click="OnBrowseTaskPlanFileClick"/>
                        </Grid>
                    </StackPanel>
                    <CheckBox x:Name="SyncPredecessorLinksCheck"
                              Content="{DynamicResource Cfg_SyncPredLinks}"
                              IsChecked="True" Margin="0,10,0,0" FontSize="11"/>
                    <CheckBox x:Name="EnforceStoryCompletionWithTasksCheck"
                              Content="{DynamicResource Cfg_EnforceStoryCompletionWithTasks}"
                              IsChecked="True" Margin="0,6,0,0" FontSize="11"/>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource Cfg_FutureSprints}" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="FutureSprintDaysBox" Height="26" Padding="6,3" Width="80" Text="90"/>
                            <TextBlock Text="{DynamicResource Cfg_FutureSprintsHint}" FontSize="11"
                                       Foreground="#888" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock FontSize="11" Foreground="#666" Margin="0,0,0,4" TextWrapping="Wrap"
                                   Text="{DynamicResource Cfg_RequiredFieldsHint}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Cfg_FieldRefHint}" FontSize="10" Foreground="#888" Margin="0,0,0,2"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Cfg_DefaultValueHint}" FontSize="10" Foreground="#888" Margin="0,0,0,2"/>
                        </Grid>
                        <ItemsControl x:Name="ExtraFieldsList" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Height="26" Padding="6,3" Text="{Binding Ref, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="2" Height="26" Padding="6,3" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="4" Content="✕" Width="26" Height="26" Padding="0"
                                                Tag="{Binding}" Click="OnRemoveExtraField"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{DynamicResource Cfg_AddField}" HorizontalAlignment="Left" Padding="8,4"
                                Margin="0,4,0,0" Click="OnAddExtraField"/>
                    </StackPanel>
                    <!-- Campos de classificação por tipo DevOps -->
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="{DynamicResource Cfg_ClassSection}" FontSize="11" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,4"/>
                        <TextBlock FontSize="10" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="{DynamicResource Cfg_ClassHint}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Cfg_ColDevOpsType}"   FontSize="10" Foreground="#666"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Cfg_ColFieldRef}"  FontSize="10" Foreground="#666"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource Cfg_ColFieldType}" FontSize="10" Foreground="#666"/>
                            <TextBlock Grid.Column="6" Text="{DynamicResource Cfg_ColValues}"  FontSize="10" Foreground="#666"/>
                        </Grid>
                        <ItemsControl x:Name="ClassificationMappingsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="26"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Height="26" Padding="4,2" FontSize="11"
                                                  SelectedItem="{Binding DevOpsType, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding AvailableTypes}"/>
                                        <TextBox Grid.Column="2" Height="26" Padding="6,3" FontSize="11"
                                                 Text="{Binding FieldRef, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{DynamicResource Cfg_FieldRefTip}"/>
                                        <ComboBox Grid.Column="4" Height="26" Padding="4,2" FontSize="11"
                                                  SelectedItem="{Binding FieldType, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding AvailableFieldTypes}"
                                                  ToolTip="{DynamicResource Cfg_FieldTypeTip}"/>
                                        <TextBox Grid.Column="6" Height="26" Padding="6,3" FontSize="11"
                                                 Text="{Binding Values, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{DynamicResource Cfg_ValuesTip}"/>
                                        <Button Grid.Column="8" Content="✕" Width="26" Height="26" Padding="0" FontSize="11"
                                                Tag="{Binding}" Click="OnRemoveClassificationMapping"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{DynamicResource Cfg_AddMapping}" HorizontalAlignment="Left" Padding="8,4"
                                Margin="0,4,0,0" Click="OnAddClassificationMapping"/>
                    </StackPanel>
                </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText"
                           Foreground="#B00020" TextWrapping="Wrap"
                           Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
            </ScrollViewer>

            <!-- Botões -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="SaveButton" Content="{DynamicResource Cfg_Save}" Width="120" Height="34"
                        FontSize="13" FontWeight="SemiBold"
                        IsDefault="True" Click="OnSaveClick"/>
                <Button Content="{DynamicResource Cfg_Cancel}" Width="100" Height="34" Margin="10,0,0,0"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
