<Window x:Class="NXProject.Views.PlanItemPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TaskPlan_PickTitle}"
        Width="760"
        Height="560"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0"
                   FontSize="20" FontWeight="SemiBold" Foreground="#2B579A"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="30" Padding="8,4"
                     VerticalContentAlignment="Center"
                     TextChanged="OnSearchTextChanged"/>
            <Button Grid.Column="1" Content="{DynamicResource Pred_ClearSearch}"
                    Width="96" Height="30" Margin="8,0,0,0"
                    Click="OnClearSearchClick"/>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#D9E1EA" BorderThickness="1" Background="#FFFFFF">
            <ListBox x:Name="CandidateList"
                     ItemsSource="{Binding Rows}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayId}"
                                       FontWeight="SemiBold" Foreground="#2B579A" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ParentName}" FontSize="10" Foreground="#888"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource Pred_Cancel}" Width="96" Height="30" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="OK" Width="96" Height="30" IsDefault="True" Click="OnOkClick"/>
        </StackPanel>
    </Grid>
</Window>
