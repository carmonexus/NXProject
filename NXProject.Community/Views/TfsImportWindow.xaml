<Window x:Class="NXProject.Views.TfsImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Imp_Title}"
        Loaded="OnWindowLoaded"
        Width="600" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Border Padding="24,20,24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Imp_Title}"
                           FontSize="20" FontWeight="SemiBold" Foreground="#2B579A"/>
                <TextBlock Text="{DynamicResource Imp_Subtitle}"
                           FontSize="12" Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- Aviso de conexão não configurada -->
                <Border x:Name="NotConfiguredHint" Background="#FFF3E0" BorderBrush="#F0C36D" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Imp_NotConfigured}" FontSize="11.5" Foreground="#5D4037" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="{DynamicResource Imp_Configure}" Padding="8,3" FontSize="11" Click="OnOpenConfigClick" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ══ PASSO 1 ══ Portfólio ═══════════════════════════════════ -->
                <Border Background="#EEF4FB" BorderBrush="#B8D0EC" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Background="#2B579A" CornerRadius="10" Width="20" Height="20">
                                    <TextBlock Text="1" Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Imp_Step1Title}"
                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="#2B579A"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ManageListButton"
                                    Content="{DynamicResource Imp_ManagePortfolio}"
                                    Height="26" Padding="10,2" FontSize="11"
                                    Click="OnManageListClick"
                                    ToolTip="{DynamicResource Imp_ManageTip}"/>
                        </Grid>

                        <TextBlock FontSize="11" Foreground="#555" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Text="{DynamicResource Imp_SelectProject}"/>

                        <ComboBox x:Name="DevOpsProjectCombo"
                                  Height="30" Padding="6,4" FontSize="12"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="OnProjectComboChanged"
                                  ToolTip="{DynamicResource Imp_ComboTip}"/>
                        <TextBlock x:Name="ListPathLabel"
                                   FontSize="10" Foreground="#888" Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{DynamicResource Imp_NoPortfolio}"/>
                    </StackPanel>
                </Border>

                <!-- ══ PASSO 2 ══ Projeto raiz ════════════════════════════════ -->
                <Border x:Name="RootIdSection" Background="#F5F9F5" BorderBrush="#B5D5B5" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#2E7D32" CornerRadius="10" Width="20" Height="20">
                                    <TextBlock Text="2" Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Imp_Step2Title}"
                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="#2E7D32"/>
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="#555" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="{DynamicResource Imp_RootIdHelp}"/>
                            <TextBox x:Name="RootIdBox" Height="28" Padding="6,4" FontSize="13" Width="160" HorizontalAlignment="Left"
                                     IsReadOnly="True" Background="#F0F0F0" Foreground="#444" Cursor="Arrow"
                                     ToolTip="{DynamicResource Imp_RootIdTip}"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="OpenCalendarButton"
                                Content="{DynamicResource Imp_Calendar}"
                                Height="28" Padding="10,4" FontSize="11"
                                VerticalAlignment="Bottom"
                                Click="OnOpenCalendarClick"
                                ToolTip="{DynamicResource Imp_CalendarTip}"/>
                    </Grid>
                </Border>

                <!-- Nota sobre regras de cronograma -->
                <Border x:Name="ImportHintBorder" Background="#FFFDE7" BorderBrush="#F9E08A" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                    <TextBlock TextWrapping="Wrap" Foreground="#5D4037" FontSize="11.5"
                               Text="{DynamicResource Imp_ScheduleRules}"/>
                </Border>

                <TextBlock x:Name="StatusText"
                           Foreground="#B00020" TextWrapping="Wrap"
                           Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
            </ScrollViewer>

            <!-- Botões -->
            <DockPanel Grid.Row="2" Margin="0,16,0,0">
                <Button DockPanel.Dock="Left"
                        Content="{DynamicResource Imp_ConfigDevOps}" Padding="10,4" FontSize="11"
                        Click="OnOpenConfigClick"
                        ToolTip="{DynamicResource Imp_ConfigDevOpsTip}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ImportButton" Content="{DynamicResource Imp_Import}" Width="120" Height="34"
                            FontSize="13" FontWeight="SemiBold"
                            IsDefault="True" Click="OnImportClick"/>
                    <Button Content="{DynamicResource Imp_Cancel}" Width="100" Height="34" Margin="10,0,0,0"
                            IsCancel="True"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
