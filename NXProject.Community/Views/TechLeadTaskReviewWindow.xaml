<Window x:Class="NXProject.Views.TechLeadTaskReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TLR_Title}"
        Width="1320" Height="700"
        MinWidth="1040" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="EditCell" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- cabeçalho + botões devops -->
            <RowDefinition Height="Auto"/>  <!-- breadcrumb seleção -->
            <RowDefinition Height="Auto"/>  <!-- filtros -->
            <RowDefinition Height="*"/>     <!-- grid -->
            <RowDefinition Height="Auto"/>  <!-- totais -->
            <RowDefinition Height="Auto"/>  <!-- botões cronograma -->
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{DynamicResource TLR_Title}"
                           FontSize="18" FontWeight="SemiBold" Foreground="#2B579A"/>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#666" Margin="0,2,0,0"
                           Text="{DynamicResource TLR_Loading}"/>
            </StackPanel>
        </StackPanel>

        <!-- Breadcrumb da task selecionada: Epic > Feature > Story -->
        <Border Grid.Row="1" Background="#F3F6FC" CornerRadius="4" Padding="10,6"
                Margin="0,0,0,8" Visibility="{Binding ElementName=BreadcrumbPanel, Path=Visibility}">
            <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="📍" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="EpicBreadcrumb"    FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                <TextBlock x:Name="FeatureBreadcrumb" FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
                <TextBlock x:Name="StoryBreadcrumb"   FontSize="11" FontWeight="SemiBold" Foreground="#2B579A" VerticalAlignment="Center"/>
                <TextBlock Text=" › " FontSize="11" Foreground="#999" VerticalAlignment="Center"/>
                <TextBlock x:Name="TaskBreadcrumb"    FontSize="11" Foreground="#333" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Filtros -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource TLR_Filter}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                <CheckBox x:Name="FilterEmAndamentoBox" Content="{DynamicResource TLR_InProgress}"
                          VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"
                          ToolTip="{DynamicResource TLR_InProgressTip}"
                          Checked="OnProgressFilterChanged" Unchecked="OnProgressFilterChanged"/>
                <CheckBox x:Name="FilterNaoIniciadaBox" Content="{DynamicResource TLR_NotStarted}"
                          VerticalAlignment="Center" FontSize="12" Margin="0,0,16,0"
                          ToolTip="{DynamicResource TLR_NotStartedTip}"
                          Checked="OnProgressFilterChanged" Unchecked="OnProgressFilterChanged"/>
                <Separator Width="1" Height="20" Background="#CCC" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource TLR_Status}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                <ComboBox x:Name="StateFilterBox" Width="120" FontSize="12" Margin="0,0,8,0"
                          SelectionChanged="OnStateFilterChanged"/>
                <Button Content="{DynamicResource TLR_Reload}" Click="OnReloadClick"
                        Padding="8,3" FontSize="12" Margin="0,0,12,0"/>
                <Separator Width="1" Height="20" Background="#CCC" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="DevOps" FontSize="10" Foreground="#888" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource TLR_StoryDuration}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                <TextBox x:Name="StoryDurationBox" Width="60" FontSize="12" Margin="0,0,4,0"
                         VerticalContentAlignment="Center" ToolTip="{DynamicResource TLR_StoryDurationTip}"/>
                <TextBlock Text="{DynamicResource TLR_HourUnit}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <Button Content="{DynamicResource TLR_Ratear}" x:Name="RatearButton"
                        Click="OnRatearClick"
                        Height="28" Padding="10,0" Margin="0,0,8,0"
                        Background="#7B3F00" Foreground="White"
                        ToolTip="{DynamicResource TLR_RatearTip}"/>
                <Button Content="{DynamicResource TLR_Zerar}" x:Name="ZerarButton"
                        Click="OnZerarClick"
                        Height="28" Padding="10,0" Margin="0,0,8,0"
                        Background="#555" Foreground="White"
                        ToolTip="{DynamicResource TLR_ZerarTip}"/>
            </WrapPanel>

            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource TLR_Epic}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                <ComboBox x:Name="EpicFilterBox" Width="260" FontSize="12" Margin="0,0,12,0"
                          ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                          SelectionChanged="OnEpicFilterChanged"/>
                <TextBlock Text="{DynamicResource TLR_Feature}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                <ComboBox x:Name="FeatureFilterBox" Width="280" FontSize="12" Margin="0,0,12,0"
                          ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                          SelectionChanged="OnFeatureFilterChanged"/>
                <TextBlock Text="{DynamicResource TLR_Story}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                <ComboBox x:Name="StoryFilterBox" Width="300" FontSize="12" Margin="0,0,12,0"
                          ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                          SelectionChanged="OnStoryFilterChanged"/>
                <Button x:Name="BuscarButton" Content="{DynamicResource TLR_BuscarTasks}"
                        Click="OnBuscarClick"
                        Padding="8,3" FontSize="12" Margin="0,0,12,0"
                        Background="#2B579A" Foreground="White"
                        Visibility="Collapsed"/>
            </WrapPanel>
        </StackPanel>

        <!-- Grid de Tasks editável -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="118"/>
            </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0"
                  x:Name="TasksGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="20"
                  SelectionMode="Extended"
                  SelectionChanged="OnTasksGridSelectionChanged"
                  CellEditEnding="OnCellEditEnding"
                  TextElement.FontSize="12"
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="OnGridMouseLeftButtonDown"
                  PreviewMouseMove="OnGridMouseMove"
                  Drop="OnGridDrop">
            <DataGrid.RowHeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="⠿" FontSize="11" Foreground="#999" ToolTip="{DynamicResource TLR_DragToReorder}" Cursor="SizeAll"/>
                </DataTemplate>
            </DataGrid.RowHeaderTemplate>
            <DataGrid.Columns>
                <!-- Seleção -->
                <DataGridCheckBoxColumn Header="" Width="28"
                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Numeração sequencial -->
                <DataGridTextColumn Header="#" Width="32"
                    Binding="{Binding RowNumber}" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#999"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Hierarquia (somente leitura) -->
                <DataGridTextColumn Header="ID" Width="60"
                    Binding="{Binding TaskId}" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#2B579A"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <!-- Task (editável, com badge Block) -->
                <DataGridTemplateColumn Header="{DynamicResource TLR_ColTask}" Width="340">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#C0392B" CornerRadius="3" Padding="3,1"
                                        Margin="0,0,4,0"
                                        Visibility="{Binding IsBlockedState, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource TLR_BlockBadge}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource EditCell}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Status (editável via template) -->
                <DataGridTemplateColumn Header="{DynamicResource TLR_ColStatus}" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding State}" Padding="2,0"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Closed">
                                                <Setter Property="Foreground" Value="#217346"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Active">
                                                <Setter Property="Foreground" Value="#2B579A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="New">
                                                <Setter Property="Foreground" Value="#888"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox x:Name="StateCombo"
                                      SelectedItem="{Binding State, UpdateSourceTrigger=PropertyChanged}"
                                      Loaded="OnStateComboLoaded"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- HH Estimado (editável) -->
                <DataGridTextColumn Header="{DynamicResource TLR_ColHHEst}" Width="72"
                    Binding="{Binding EstimatedHours, StringFormat={}{0:0.#}, UpdateSourceTrigger=LostFocus}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- HH Concluído (somente leitura) -->
                <DataGridTextColumn Header="{DynamicResource TLR_ColHHConc}" Width="72"
                    Binding="{Binding CompletedHours, StringFormat={}{0:0.#}}" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,4,0"/>
                            <Setter Property="Foreground" Value="#666"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- % Conclusão (somente leitura) -->
                <DataGridTextColumn Header="{DynamicResource TLR_ColPctConc}" Width="66"
                    Binding="{Binding PercentComplete, StringFormat={}{0:0.#}%}" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,4,0"/>
                            <Setter Property="Foreground" Value="#444"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Prioridade (editável) -->
                <DataGridTextColumn Header="{DynamicResource TLR_ColPri}" Width="45"
                    Binding="{Binding Priority, UpdateSourceTrigger=LostFocus}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="#E07000"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Responsável (ComboBox com lista de recursos do projeto) -->
                <DataGridTemplateColumn Header="{DynamicResource TLR_ColAssigned}" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AssignedToDisplay}" Padding="3,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding ResourceList, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Text="{Binding AssignedToDisplay, UpdateSourceTrigger=LostFocus}"
                                      IsEditable="True"
                                      StaysOpenOnEdit="False"
                                      FontSize="12"
                                      SelectionChanged="OnResourceSelectionChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Categoria / Activity (ComboBox editável sincroniza Microsoft.VSTS.Common.Activity) -->
                <DataGridTemplateColumn Header="{DynamicResource TLR_ColCategory}" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Activity}" Padding="2,0" FontSize="12"
                                       Foreground="#444"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Activity, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      Loaded="OnActivityComboLoaded"
                                      FontSize="12"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- No cronograma (somente leitura) -->
                <DataGridTextColumn Header="{DynamicResource TLR_ColAddSchedule}" Width="90"
                    Binding="{Binding InScheduleDisplay}" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Block -->
                <DataGridTemplateColumn Header="{DynamicResource TLR_ColBlock}" Width="62" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding BlockButtonLabel}"
                                    Click="OnToggleBlockClick"
                                    Padding="4,1" FontSize="10"
                                    Cursor="Hand"
                                    Background="{Binding BlockButtonColor}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    ToolTip="{DynamicResource TLR_BlockToggleTip}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                            <Setter Property="Background" Value="#FFFDE7"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding InSchedule}" Value="True">
                            <Setter Property="Foreground" Value="#888"/>
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2B579A"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ContextMenu>
                <ContextMenu Opened="OnGridContextMenuOpened">
                    <MenuItem x:Name="BlockTaskMenuItem"
                              Header="{DynamicResource TLR_AddBlockMenu}"
                              Click="OnRowToggleBlockClick"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

            <Border Grid.Column="1"
                    Margin="8,0,0,0"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    Background="#F8FAFC"
                    Padding="7">
                <StackPanel>
                    <Button x:Name="AlterTaskButton"
                            Content="{DynamicResource TLR_AlterTaskLocal}"
                            Height="42"
                            Margin="0,0,0,7"
                            FontSize="11"
                            Padding="3"
                            ToolTip="{DynamicResource TLR_AlterTaskTip}"
                            Click="OnAlterTaskClick"/>
                    <Button x:Name="OpenTfsButton"
                            Content="{DynamicResource TLR_OpenTfs}"
                            Height="42"
                            Margin="0,0,0,7"
                            FontSize="10.5"
                            Padding="3"
                            ToolTip="{DynamicResource TLR_OpenTfsTip}"
                            Click="OnOpenTfsClick"/>
                    <Button x:Name="IncludeTaskButton"
                            Content="{DynamicResource TLR_IncludeTaskOnline}"
                            Height="42"
                            Margin="0,0,0,7"
                            FontSize="11"
                            Padding="3"
                            ToolTip="{DynamicResource TLR_IncludeTaskTip}"
                            Click="OnIncludeTaskClick"/>
                    <Button x:Name="DeleteTaskButton"
                            Content="{DynamicResource TLR_DeleteTfsOnline}"
                            Height="42"
                            Margin="0,0,0,7"
                            FontSize="10.5"
                            Padding="3"
                            ToolTip="{DynamicResource TLR_DeleteTfsTip}"
                            Click="OnDeleteTaskClick"/>
                    <Button x:Name="SaveChangesButton"
                            Content="{DynamicResource TLR_SaveTfsOnline}"
                            Height="42"
                            FontSize="10.5"
                            Padding="3"
                            Background="#217346"
                            Foreground="White"
                            IsEnabled="False"
                            ToolTip="{DynamicResource TLR_SaveTfsTip}"
                            Click="OnSaveChangesClick"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Totais e dica de edição -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock x:Name="TotalsText" FontSize="11" Foreground="#666"/>
            <TextBlock Text="{DynamicResource TLR_DirtyHint}"
                       FontSize="11" Foreground="#B8860B" Margin="8,0,0,0"
                       x:Name="DirtyHint" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Botões Cronograma -->
        <Border Grid.Row="5" Margin="0,10,0,4" BorderBrush="#D0D8E8" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <DockPanel>
                <TextBlock Text="{DynamicResource TLR_Schedule}" FontSize="10" Foreground="#888" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="ExpandAllButton" Content="{DynamicResource TLR_ExpandAll}"
                            Click="OnExpandAllClick" Height="28" Padding="10,0" Margin="0,0,8,0"
                            Background="#5C3E8F" Foreground="White" Visibility="Collapsed"/>
                    <Button x:Name="AddSelectedButton" Content="{DynamicResource TLR_AddSelected}"
                            Click="OnAddSelectedClick" Height="28" Padding="10,0" Margin="0,0,8,0"
                            Background="#2B579A" Foreground="White" IsEnabled="False" Visibility="Collapsed"/>
                    <Button x:Name="ReleaseButton" Content="{DynamicResource TLR_Memorize}"
                            Click="OnMemorizeClick" Height="28" Padding="10,0" Margin="0,0,8,0"
                            Background="#217346" Foreground="White" Visibility="Collapsed"
                            ToolTip="{DynamicResource TLR_MemorizeTip}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource TLR_Release}" Click="OnCloseClick" Width="140" Height="28"
                            ToolTip="{DynamicResource TLR_ReleaseTip}"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>
