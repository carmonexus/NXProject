<Window x:Class="NXProject.Views.LocalAIManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource LocalAI_Title}"
        Width="780" Height="660"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource LocalAI_Title}"
                   FontSize="17" FontWeight="SemiBold" Foreground="#2B579A"/>
        <TextBlock Grid.Row="1" Text="{DynamicResource LocalAI_Subtitle}"
                   FontSize="11" Foreground="#667" TextWrapping="Wrap" Margin="0,4,0,10"/>

      <TabControl Grid.Row="2">
        <!-- ══ Aba LLaMA ══ -->
        <TabItem Header="{DynamicResource LocalAI_TabLlama}">
         <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pasta dos recursos -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource LocalAI_Folder}" FontSize="11" Foreground="#666" Margin="0,0,0,3"/>
                <TextBox x:Name="FolderBox" Height="26" Padding="6,3"/>
            </StackPanel>
            <Button Grid.Column="1" Content="..." Width="34" Height="26" Margin="6,17,0,0"
                    VerticalAlignment="Top" Click="OnBrowseFolderClick"/>
        </Grid>

        <!-- Status da instalação -->
        <Border Grid.Row="1" Background="#F5F7FA" BorderBrush="#D0D7E0" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
            <StackPanel>
                <!-- Processamento (backend nativo): CPU ou GPU — muda só o pacote de DLLs
                     baixado para a pasta; o wrapper LLamaSharp.dll do Setup é o mesmo. -->
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource LocalAI_BackendKindLabel}" FontSize="12"
                               FontWeight="SemiBold" Foreground="#2B579A" VerticalAlignment="Center"/>
                    <RadioButton x:Name="BackendCpuRadio" GroupName="BackendKind" Margin="10,0,0,0"
                                 Content="{DynamicResource LocalAI_BackendCpu}" FontSize="12"
                                 VerticalAlignment="Center" IsChecked="True"
                                 Checked="OnBackendKindChanged"
                                 ToolTip="{DynamicResource LocalAI_BackendCpuTip}"/>
                    <RadioButton x:Name="BackendCudaRadio" GroupName="BackendKind" Margin="14,0,0,0"
                                 Content="{DynamicResource LocalAI_BackendCuda}" FontSize="12"
                                 VerticalAlignment="Center"
                                 Checked="OnBackendKindChanged"
                                 ToolTip="{DynamicResource LocalAI_BackendCudaTip}"/>
                    <RadioButton x:Name="BackendVulkanRadio" GroupName="BackendKind" Margin="14,0,0,0"
                                 Content="{DynamicResource LocalAI_BackendVulkan}" FontSize="12"
                                 VerticalAlignment="Center"
                                 Checked="OnBackendKindChanged"
                                 ToolTip="{DynamicResource LocalAI_BackendVulkanTip}"/>
                    <!-- Teto de tokens da resposta (MaxTokens da inferência) -->
                    <TextBlock Text="{DynamicResource LocalAI_MaxTokensLabel}" FontSize="12"
                               Foreground="#666" Margin="22,0,0,0" VerticalAlignment="Center"
                               ToolTip="{DynamicResource LocalAI_MaxTokensTip}"/>
                    <ComboBox x:Name="MaxTokensPreset" Width="150" Height="22" Margin="6,0,0,0"
                              FontSize="12" VerticalContentAlignment="Center"
                              SelectionChanged="OnMaxTokensPresetChanged"
                              ToolTip="{DynamicResource LocalAI_MaxTokensTip}">
                        <ComboBoxItem Content="{DynamicResource LocalAI_TokensMin}"    Tag="1024"/>
                        <ComboBoxItem Content="{DynamicResource LocalAI_TokensIdeal}"   Tag="2048"/>
                        <ComboBoxItem Content="{DynamicResource LocalAI_TokensMax1}"    Tag="4096"/>
                        <ComboBoxItem Content="{DynamicResource LocalAI_TokensMax2}"    Tag="6144"/>
                        <ComboBoxItem Content="{DynamicResource LocalAI_TokensCustom}"  Tag="custom"/>
                    </ComboBox>
                    <TextBox x:Name="MaxTokensBox" Width="56" Height="22" Margin="6,0,0,0"
                             FontSize="12" VerticalContentAlignment="Center"
                             LostFocus="OnMaxTokensChanged"
                             ToolTip="{DynamicResource LocalAI_MaxTokensTip}"/>
                </WrapPanel>
                <!-- Explicação rápida dos backends (o que é CUDA/Vulkan) -->
                <TextBlock Text="{DynamicResource LocalAI_BackendHint}" FontSize="10.5"
                           Foreground="#778" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource LocalAI_StatusHead}" FontWeight="SemiBold" FontSize="12"
                           Foreground="#2B579A" Margin="0,0,0,6"/>
                <TextBlock x:Name="NativeStatusText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3"/>
                <TextBlock x:Name="ModelStatusText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3"/>
                <TextBlock x:Name="BackendVersionText" FontSize="12" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,3"/>
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2">
                    <Run Text="{DynamicResource LocalAI_SourceLabel}" Foreground="#555"/>
                    <Hyperlink x:Name="BackendSourceLink" Click="OnBackendSourceLinkClick">
                        <Run x:Name="BackendSourceLinkText"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock FontSize="11" TextWrapping="Wrap">
                    <Run Text="{DynamicResource LocalAI_DocsLabel}" Foreground="#555"/>
                    <Hyperlink Click="OnBackendDocsLinkClick">
                        <Run Text="https://scisharp.github.io/LLamaSharp/"/>
                    </Hyperlink>
                </TextBlock>
                <Border Background="#FFF7E8" BorderBrush="#E8D39A" BorderThickness="1"
                        CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
                    <TextBlock Text="{DynamicResource LocalAI_Disclaimer}" FontSize="11"
                               Foreground="#5A4A1E" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Log / instalação manual -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Expander Grid.Row="0" Header="{DynamicResource LocalAI_ManualHead}" FontSize="12" IsExpanded="False">
                <StackPanel Margin="4,6,0,4">
                    <TextBlock Text="{DynamicResource LocalAI_ManualBody}" FontSize="11"
                               Foreground="#444" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBox x:Name="ManualLinksBox" IsReadOnly="True" FontSize="11" FontFamily="Consolas"
                             TextWrapping="Wrap" BorderBrush="#D0D7E0" Padding="6,4"/>
                    <Button Content="{DynamicResource LocalAI_CopyLinks}" Width="140" Height="26"
                            HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnCopyLinksClick"/>
                </StackPanel>
            </Expander>
            <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" FontSize="11" FontFamily="Consolas"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="90"
                     BorderBrush="#D0D7E0" Margin="0,8,0,0" Padding="6,4"/>
        </Grid>

        <!-- Ações -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="DownloadProgress" Grid.Column="0" Height="10" Margin="0,10,12,0"
                         Minimum="0" Maximum="100" Visibility="Collapsed"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CheckUpdateBtn" Content="{DynamicResource LocalAI_CheckUpdate}" Width="150" Height="30"
                        Margin="0,0,8,0" Click="OnCheckUpdateClick"/>
                <Button x:Name="DownloadBtn" Content="{DynamicResource LocalAI_Download}" Width="150" Height="30"
                        Margin="0,0,8,0" Click="OnDownloadClick"/>
                <Button x:Name="ValidateBtn" Content="{DynamicResource LocalAI_Validate}" Width="140" Height="30"
                        Click="OnValidateClick"/>
            </StackPanel>
        </Grid>
         </Grid>
        </TabItem>

        <!-- ══ Aba Codex (local) ══ -->
        <TabItem Header="{DynamicResource LocalAI_TabCodex}">
            <StackPanel Margin="12">
                <TextBlock Text="{DynamicResource LocalAI_CliDesc}" FontSize="12" Foreground="#555"
                           TextWrapping="Wrap" Margin="0,4,0,10"/>
                <TextBlock x:Name="CodexStatusText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CodexInstallBtn" Content="{DynamicResource LocalAI_CliInstall}" Width="220" Height="30"
                            Click="OnInstallCodexClick"/>
                    <Button x:Name="CodexOpenFolderBtn" Content="{DynamicResource LocalAI_CliOpenFolder}" Width="130" Height="30"
                            Margin="8,0,0,0" Click="OnOpenCliFolderClick"/>
                </StackPanel>
                <Border Background="#FFF7E8" BorderBrush="#E8D39A" BorderThickness="1" CornerRadius="4"
                        Padding="8,6" Margin="0,12,0,0">
                    <TextBlock Text="{DynamicResource LocalAI_CliNote}" FontSize="11" Foreground="#5A4A1E" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </TabItem>

        <!-- ══ Aba Claude Code (local) ══ -->
        <TabItem Header="{DynamicResource LocalAI_TabClaude}">
            <StackPanel Margin="12">
                <TextBlock Text="{DynamicResource LocalAI_CliDesc}" FontSize="12" Foreground="#555"
                           TextWrapping="Wrap" Margin="0,4,0,10"/>
                <TextBlock x:Name="ClaudeStatusText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ClaudeInstallBtn" Content="{DynamicResource LocalAI_CliInstall}" Width="220" Height="30"
                            Click="OnInstallClaudeClick"/>
                    <Button x:Name="ClaudeOpenFolderBtn" Content="{DynamicResource LocalAI_CliOpenFolder}" Width="130" Height="30"
                            Margin="8,0,0,0" Click="OnOpenCliFolderClick"/>
                </StackPanel>
                <Border Background="#FFF7E8" BorderBrush="#E8D39A" BorderThickness="1" CornerRadius="4"
                        Padding="8,6" Margin="0,12,0,0">
                    <TextBlock Text="{DynamicResource LocalAI_CliNote}" FontSize="11" Foreground="#5A4A1E" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </TabItem>
      </TabControl>

        <!-- Fechar (global) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseBtn" Content="{DynamicResource TaskPlan_Close}" Width="90" Height="30"
                    Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
