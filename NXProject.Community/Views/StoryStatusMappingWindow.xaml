<Window x:Class="NXProject.Views.StoryStatusMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SMap_Title}"
        Width="640" Height="480"
        MinWidth="500" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource SMap_Header}"
                   FontSize="16" FontWeight="SemiBold" Foreground="#2B579A"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1"
                   Text="{DynamicResource SMap_Hint}"
                   TextWrapping="Wrap" FontSize="11" Foreground="#666"
                   Margin="0,0,0,10"/>

        <DataGrid x:Name="MappingGrid" Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="28" FontSize="12"
                  BorderBrush="#DDD" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource SMap_ColTfsState}"
                                    Binding="{Binding TfsState, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" MinWidth="160"/>
                <DataGridTextColumn Header="{DynamicResource SMap_ColChartLabel}"
                                    Binding="{Binding ChartLabel, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" MinWidth="140"/>
                <DataGridTextColumn Header="{DynamicResource SMap_ColColor}"
                                    Binding="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}"
                                    Width="90"/>
                <DataGridTextColumn Header="{DynamicResource SMap_ColOrder}"
                                    Binding="{Binding Order, UpdateSourceTrigger=PropertyChanged}"
                                    Width="65"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="{DynamicResource SMap_Add}" Width="90" Height="28" Margin="0,0,6,0"
                    Click="OnAddClick"/>
            <Button Content="{DynamicResource SMap_Remove}" Width="80" Height="28" Margin="0,0,6,0"
                    Click="OnRemoveClick"/>
            <Button Content="{DynamicResource SMap_Defaults}" Width="100" Height="28"
                    Click="OnLoadDefaultsClick"
                    ToolTip="{DynamicResource SMap_DefaultsTip}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{DynamicResource SMap_Save}" Width="80" Height="28" Margin="0,0,8,0"
                    IsDefault="True" Click="OnSaveClick"/>
            <Button Content="{DynamicResource SMap_Cancel}" Width="80" Height="28"
                    IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
