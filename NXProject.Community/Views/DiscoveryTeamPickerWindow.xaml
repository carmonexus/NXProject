<Window x:Class="NXProject.Views.DiscoveryTeamPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TeamPick_Title}"
        Width="560" Height="560"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource TeamPick_Title}"
                   FontSize="18" FontWeight="SemiBold" Foreground="#2B579A"/>

        <TextBox Grid.Row="1" x:Name="FilterBox" Margin="0,10,0,8" Height="28"
                 Padding="6,4" VerticalContentAlignment="Center"
                 TextChanged="OnFilterChanged"
                 ToolTip="{DynamicResource TeamPick_FilterTip}"/>

        <DataGrid Grid.Row="2" x:Name="TeamGrid"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserReorderColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  RowHeight="28" FontSize="12" CanUserSortColumns="True"
                  MouseDoubleClick="OnGridDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource TeamPick_ColTeam}" Width="*" Binding="{Binding Name}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Margin="0,0,16,0"
                       FontSize="12" Foreground="#666"/>
            <Button x:Name="CancelButton" Content="{DynamicResource TeamPick_Cancel}"
                    Width="100" Height="30" Margin="0,0,8,0" Click="OnCancelClick"/>
            <Button x:Name="ImportButton" Content="{DynamicResource TeamPick_Import}"
                    Width="150" Height="30" Click="OnImportClick"
                    Background="#2B579A" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
