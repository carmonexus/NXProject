<Window x:Class="NXProject.Views.CommunityAboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About_Title}"
        Width="580"
        Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                    <Image x:Name="CompanyLogoImage"
                           DockPanel.Dock="Left"
                           Width="150"
                           Height="150"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"
                           Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NXProject Community"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#2B579A"/>

                        <TextBlock x:Name="VersionText"
                                   FontSize="13"
                                   Foreground="#666"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="{DynamicResource About_Tagline}"
                           FontSize="13"
                           Foreground="#444"
                           Margin="0,0,0,16"
                           TextWrapping="Wrap"/>

                <Border Background="#FFF7E8"
                        BorderBrush="#E8D39A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About_VersioningHeader}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource About_VersioningFormat}"
                                   TextWrapping="Wrap"
                                   Foreground="#444"/>
                        <TextBlock Text="{DynamicResource About_VersioningExample}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#444"/>
                    </StackPanel>
                </Border>

                <Border Background="#F5F7FA"
                        BorderBrush="#D9E1EA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About_Company}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Nexus XData Tecnologia Ltda"
                                   Margin="0,2,0,10"/>

                        <TextBlock Text="{DynamicResource About_GitHubHeader}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Margin="0,2,0,10">
                            <Hyperlink Click="OnNxStoreClick">https://github.com/nexusxdata/NXProject</Hyperlink>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource About_LicenseHeader}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource About_LicenseText}"
                                   Margin="0,2,0,10"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{DynamicResource About_NewVersionsHeader}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource About_NewVersionsText}"
                                   Margin="0,2,0,4"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="0,0,0,10">
                            <Hyperlink Click="OnNxStoreClick">https://github.com/nexusxdata/NXProject</Hyperlink>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource About_ContactHeader}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource About_ContactEmail}"
                                   Margin="0,2,0,4"
                                   TextWrapping="Wrap"/>
                        <TextBlock>
                            <Hyperlink Click="OnEmailClick">comercial.nexus.xdata@gmail.com</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="{DynamicResource About_Close}"
                        Width="90"
                        Height="30"
                        IsDefault="True"
                        Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
