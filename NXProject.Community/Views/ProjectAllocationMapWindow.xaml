<Window x:Class="NXProject.Views.ProjectAllocationMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PMap_Title}"
        Width="1200" Height="700"
        MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Título -->
            <RowDefinition Height="Auto"/>  <!-- Controles -->
            <RowDefinition Height="*"/>     <!-- Abas -->
            <RowDefinition Height="Auto"/>  <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="{DynamicResource PMap_Title}"
                   FontSize="18" FontWeight="SemiBold" Foreground="#2B579A"
                   Margin="0,0,0,10"/>

        <!-- Controles -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Menu VerticalAlignment="Center" Background="Transparent" Margin="0,0,16,0">
                <MenuItem x:Name="SourceBtn" Header="{DynamicResource PMap_Source}"
                          Height="28" Padding="12,0" Background="#EEF1F5" BorderBrush="#C9D3DC">
                    <MenuItem Header="{DynamicResource PMap_SelectProjects}"
                              ToolTip="{DynamicResource PMap_SelectProjectsTip}"
                              Click="OnSelectProjectsClick">
                        <MenuItem.Icon><TextBlock Text="&#x2601;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource PMap_OpenFiles}"
                              ToolTip="{DynamicResource PMap_OpenFilesTip}"
                              Click="OnOpenFilesClick">
                        <MenuItem.Icon><TextBlock Text="&#x1F4C2;"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="OpenScheduleItem" Header="{DynamicResource PMap_OpenSchedule}"
                              ToolTip="{DynamicResource PMap_OpenScheduleTip}"
                              Click="OnUseOpenScheduleClick">
                        <MenuItem.Icon><TextBlock Text="&#x1F5D3;"/></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>

            <TextBlock Text="{DynamicResource PMap_StartMonth}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
            <ComboBox x:Name="StartMonthBox" Width="110" Height="28" Margin="0,0,8,0" FontSize="12"
                      SelectionChanged="OnPeriodChanged"/>

            <TextBlock Text="{DynamicResource PMap_EndMonth}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
            <ComboBox x:Name="EndMonthBox" Width="110" Height="28" Margin="0,0,12,0" FontSize="12"
                      SelectionChanged="OnPeriodChanged"/>

            <CheckBox x:Name="OnlyWithHoursBox"
                      Content="{DynamicResource PMap_HideZeroed}"
                      VerticalAlignment="Center" Margin="0,0,12,0"
                      FontSize="12" IsChecked="True"
                      Click="OnFilterChanged"/>

            <CheckBox x:Name="OnlyCurrentHoursBox"
                      Content="{DynamicResource PMap_CompletedHH}"
                      VerticalAlignment="Center" Margin="0,0,12,0"
                      FontSize="12" IsChecked="False"
                      ToolTip="{DynamicResource PMap_CompletedHHTip}"
                      Click="OnFilterChanged"/>

            <CheckBox x:Name="ShowZeroStoriesBox"
                      Content="{DynamicResource PMap_ShowZeroStories}"
                      VerticalAlignment="Center" Margin="0,0,12,0"
                      FontSize="12" IsChecked="False"
                      ToolTip="{DynamicResource PMap_ShowZeroStoriesTip}"
                      Click="OnShowZeroStoriesChanged"/>

            <CheckBox x:Name="ShowNoPctStoriesBox"
                      Content="{DynamicResource PMap_ShowNoPctStories}"
                      VerticalAlignment="Center" Margin="0,0,12,0"
                      FontSize="12" IsChecked="False"
                      Foreground="#C0392B"
                      ToolTip="{DynamicResource PMap_ShowNoPctStoriesTip}"
                      Click="OnFilterChanged"/>

            <Button Content="{DynamicResource PMap_ExportExcel}" Height="28" Padding="10,0"
                    Click="OnExportExcelClick"/>
        </WrapPanel>

        <!-- Abas -->
        <TabControl Grid.Row="2" x:Name="MainTabControl" SelectionChanged="OnTabChanged">

            <!-- ══ ABA 1: Horas por Projeto ══ -->
            <TabItem Header="{DynamicResource PMap_TabHours}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>  <!-- Cabeçalho meses -->
                        <RowDefinition Height="20"/>  <!-- Sub-cabeçalho -->
                        <RowDefinition Height="*"/>   <!-- Dados -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>  <!-- Projeto -->
                        <ColumnDefinition Width="160"/>  <!-- Recurso -->
                        <ColumnDefinition Width="80"/>   <!-- Tipo -->
                        <ColumnDefinition Width="120"/>  <!-- CC -->
                        <ColumnDefinition Width="*"/>    <!-- Meses (rola) -->
                    </Grid.ColumnDefinitions>

                    <!-- Cabeçalho linha 1 -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#2B579A" BorderBrush="#1D3F73" BorderThickness="0,0,1,1">
                        <TextBlock Text="{DynamicResource PMap_ColProject}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#2B579A" BorderBrush="#1D3F73" BorderThickness="0,0,1,1">
                        <TextBlock Text="{DynamicResource PMap_ColResource}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Background="#2B579A" BorderBrush="#1D3F73" BorderThickness="0,0,1,1">
                        <TextBlock Text="{DynamicResource PMap_ColType}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="3" Background="#2B579A" BorderBrush="#1D3F73" BorderThickness="0,0,1,1">
                        <TextBlock Text="{DynamicResource PMap_ColCostCenter}" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                   VerticalAlignment="Center" Margin="4,0,0,0" TextWrapping="Wrap"/>
                    </Border>
                    <ScrollViewer x:Name="MonthHeaderScroll" Grid.Row="0" Grid.Column="4"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MonthHeaderPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Cabeçalho linha 2 -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#E8EEF8" BorderBrush="#C5D0E0" BorderThickness="0,0,1,1"/>
                    <Border Grid.Row="1" Grid.Column="1" Background="#E8EEF8" BorderBrush="#C5D0E0" BorderThickness="0,0,1,1"/>
                    <Border Grid.Row="1" Grid.Column="2" Background="#E8EEF8" BorderBrush="#C5D0E0" BorderThickness="0,0,1,1"/>
                    <Border Grid.Row="1" Grid.Column="3" Background="#E8EEF8" BorderBrush="#C5D0E0" BorderThickness="0,0,1,1"/>
                    <ScrollViewer x:Name="ResourceHeaderScroll" Grid.Row="1" Grid.Column="4"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ResourceHeaderPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Dados -->
                    <ScrollViewer x:Name="LeftScroll" Grid.Row="2" Grid.Column="0"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ProjectNamePanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer x:Name="ResScroll" Grid.Row="2" Grid.Column="1"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ProjectResPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer x:Name="TypeScroll" Grid.Row="2" Grid.Column="2"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ProjectTypePanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer x:Name="CcScroll" Grid.Row="2" Grid.Column="3"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ProjectCcPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer x:Name="MainScroll" Grid.Row="2" Grid.Column="4"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="OnMainScrollChanged">
                        <ItemsControl x:Name="DataRowsPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ══ ABA 2: Distribuição por Pessoa ══ -->
            <TabItem Header="{DynamicResource PMap_TabDistribution}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>  <!-- Cabeçalho projetos -->
                        <RowDefinition Height="20"/>  <!-- Sub-cabeçalho (tipo) -->
                        <RowDefinition Height="*"/>   <!-- Dados -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>  <!-- Recurso (fixo) -->
                        <ColumnDefinition Width="*"/>    <!-- Projetos (rola) -->
                    </Grid.ColumnDefinitions>

                    <!-- Cabeçalho fixo -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#2B579A" BorderBrush="#1D3F73" BorderThickness="0,0,1,1">
                        <TextBlock Text="{DynamicResource PMap_ColResourcePerson}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Background="#E8EEF8" BorderBrush="#C5D0E0" BorderThickness="0,0,1,1"/>

                    <!-- Cabeçalho de projetos (rola horizontal) -->
                    <ScrollViewer x:Name="DistProjHeaderScroll" Grid.Row="0" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DistProjHeaderPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer x:Name="DistTypeHeaderScroll" Grid.Row="1" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DistTypeHeaderPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Coluna Recurso (fixa, rola vertical) -->
                    <ScrollViewer x:Name="DistResScroll" Grid.Row="2" Grid.Column="0"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DistResPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Dados (rola ambos) -->
                    <ScrollViewer x:Name="DistMainScroll" Grid.Row="2" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="OnDistScrollChanged">
                        <ItemsControl x:Name="DistDataPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ══ ABA 3: Stories por Recurso ══ -->
            <TabItem Header="{DynamicResource PMap_TabStories}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>  <!-- Cabeçalho meses (2 linhas) -->
                        <RowDefinition Height="*"/>   <!-- Dados -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="730"/>  <!-- Recurso + Projeto + EPIC + Feature + Story (fixo) -->
                        <ColumnDefinition Width="*"/>    <!-- Meses (rola) -->
                    </Grid.ColumnDefinitions>

                    <!-- Cabeçalho fixo (2 linhas: linha vazia + labels) -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#2B579A" BorderBrush="#1D3F73" BorderThickness="0,0,1,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource PMap_ColResource}" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                           Width="130" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBlock Text="{DynamicResource PMap_ColProject}" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                           Width="120" VerticalAlignment="Center"/>
                                <TextBlock Text="EPIC" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                           Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="Feature" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                           Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource PMap_ColStory}" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cabeçalho de meses (rola horizontal) -->
                    <ScrollViewer x:Name="SrHeaderScroll" Grid.Row="0" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SrHeaderPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Coluna fixa (rola vertical) -->
                    <ScrollViewer x:Name="SrLeftScroll" Grid.Row="1" Grid.Column="0"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="OnSrLeftScrollChanged">
                        <ItemsControl x:Name="SrLeftPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Dados (rola ambos) -->
                    <ScrollViewer x:Name="SrMainScroll" Grid.Row="1" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="OnSrScrollChanged">
                        <ItemsControl x:Name="SrDataPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource PMap_TabRateio}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Header fixo -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  x:Name="RateioHeaderScroll">
                        <ItemsControl x:Name="RateioHeaderPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Dados -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  x:Name="RateioDataScroll">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Coluna fixa: Recurso + Projeto -->
                            <ItemsControl Grid.Column="0" x:Name="RateioLeftPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <!-- Dados por mês -->
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          x:Name="RateioDataScrollInner">
                                <ItemsControl x:Name="RateioDataPanel">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource PMap_TabInternal}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="730"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="#5B3270" BorderBrush="#3D1F50" BorderThickness="0,0,1,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource PMap_InternalHeader}"
                                       Foreground="White" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource PMap_ColResource}" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                           Width="130" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBlock Text="{DynamicResource PMap_ColProject}" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                           Width="120" VerticalAlignment="Center"/>
                                <TextBlock Text="EPIC" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                           Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="Feature" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                           Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource PMap_ColStory}" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="IntHeaderScroll" Grid.Row="0" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="IntHeaderPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer x:Name="IntLeftScroll" Grid.Row="1" Grid.Column="0"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="OnIntLeftScrollChanged">
                        <ItemsControl x:Name="IntLeftPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer x:Name="IntMainScroll" Grid.Row="1" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="OnIntScrollChanged">
                        <ItemsControl x:Name="IntDataPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Time sheet: horas/dia do recurso no mês, pelo calendário útil -->
            <TabItem Header="{DynamicResource PMap_TabTimeSheet}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="6,6,6,4">
                        <TextBlock Text="{DynamicResource PMap_TsResource}" VerticalAlignment="Center"
                                   FontSize="11" Foreground="#555" Margin="0,0,6,0"/>
                        <ComboBox x:Name="TsResourceCombo" Width="220" Height="26" FontSize="11"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="OnTimeSheetFilterChanged"/>
                        <TextBlock Text="{DynamicResource PMap_TsMonth}" VerticalAlignment="Center"
                                   FontSize="11" Foreground="#555" Margin="14,0,6,0"/>
                        <ComboBox x:Name="TsMonthCombo" Width="120" Height="26" FontSize="11"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="OnTimeSheetFilterChanged"/>
                        <ComboBox x:Name="TsYearCombo" Width="80" Height="26" FontSize="11" Margin="6,0,0,0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="OnTimeSheetFilterChanged"/>
                        <Button x:Name="TsGenerateButton" Content="{DynamicResource PMap_TsGenerate}"
                                Width="130" Height="26" Margin="14,0,0,0" Click="OnTimeSheetGenerateClick"
                                Background="#2B579A" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                        <Button x:Name="TsClearButton" Content="{DynamicResource PMap_TsClear}"
                                Width="90" Height="26" Margin="6,0,0,0" Click="OnTimeSheetClearClick" FontSize="11"/>
                        <Button x:Name="TsExportButton" Content="{DynamicResource PMap_TsExport}"
                                Width="150" Height="26" Margin="6,0,0,0" Click="OnTimeSheetExportClick"
                                Background="#1B5E20" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                        <Button x:Name="TsSaveBaseButton" Content="{DynamicResource PMap_TsSaveBase}"
                                Width="160" Height="26" Margin="14,0,0,0" Click="OnTimeSheetSaveBaseClick"
                                ToolTip="{DynamicResource PMap_TsSaveBaseTip}" FontSize="11"/>
                        <Button x:Name="TsOpenBaseButton" Content="{DynamicResource PMap_TsOpenBase}"
                                Width="160" Height="26" Margin="6,0,0,0" Click="OnTimeSheetOpenBaseClick"
                                ToolTip="{DynamicResource PMap_TsOpenBaseTip}" FontSize="11"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="6,0,6,6">
                        <TextBlock Text="{DynamicResource PMap_TsAttendance}" VerticalAlignment="Center"
                                   FontSize="11" Foreground="#555" Margin="0,0,6,0"/>
                        <TextBox x:Name="TsAttendanceBox" Width="110" Height="24" Text="Teams" FontSize="11" VerticalContentAlignment="Center"/>
                        <CheckBox x:Name="TsFillGapsBox" IsChecked="True" FontSize="11" Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnTimeSheetFilterChanged" Unchecked="OnTimeSheetFilterChanged"
                                  Content="{DynamicResource PMap_TsFillGaps}"
                                  ToolTip="{DynamicResource PMap_TsFillGapsTip}"/>
                    </WrapPanel>

                    <DataGrid x:Name="TsGrid" Grid.Row="2" Margin="6,0,6,0"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="All" HeadersVisibility="Column" RowHeight="24" FontSize="11">
                        <!-- Negrito: atividade herdada do dia anterior (dia sem atividade no cronograma) -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCarriedOver}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="ToolTip" Value="{DynamicResource PMap_TsCarriedTip}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColDay}" Width="80" IsReadOnly="True"
                                                Binding="{Binding DayText}"/>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColWeekDay}" Width="44" IsReadOnly="True"
                                                Binding="{Binding WeekDayNumber}"/>
                            <!-- Atividade: combo quando o dia tem opção em mais de um cronograma -->
                            <DataGridTemplateColumn Header="{DynamicResource PMap_TsColActivity}" Width="320">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ComboBox ItemsSource="{Binding Options}"
                                                      SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                      SelectionChanged="OnTimeSheetOptionChanged"
                                                      DisplayMemberPath="Display"
                                                      FontSize="11" BorderThickness="0"
                                                      Background="Transparent"
                                                      VerticalContentAlignment="Center">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasOptions}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <TextBlock Text="{Binding Activity}" VerticalAlignment="Center"
                                                       Margin="4,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasOptions}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColSource}" Width="150" IsReadOnly="True"
                                                Binding="{Binding SourceProject}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#666"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColMorningIn}"  Width="70" Binding="{Binding MorningIn}"/>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColMorningOut}" Width="70" Binding="{Binding MorningOut}"/>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColAfternoonIn}"  Width="70" Binding="{Binding AfternoonIn}"/>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColAfternoonOut}" Width="70" Binding="{Binding AfternoonOut}"/>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColTotal}" Width="60" IsReadOnly="True"
                                                Binding="{Binding TotalText}"/>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColDescription}" Width="240"
                                                Binding="{Binding Description}"/>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColCapex}" Width="180" Binding="{Binding CapexProject}"/>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColPep}"   Width="110" Binding="{Binding PepElement}"/>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColManager}" Width="180" Binding="{Binding Manager}"/>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColAttendance}" Width="110" Binding="{Binding Attendance}"/>
                            <DataGridTextColumn Header="{DynamicResource PMap_TsColNote}" Width="160" Binding="{Binding Note}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Background="#EBF0FC" BorderBrush="#B4C8E6" BorderThickness="0,1,0,0"
                            Padding="8,4" Margin="6,4,6,6">
                        <TextBlock x:Name="TsTotalText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#143C8C" HorizontalAlignment="Right"/>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status bar -->
        <TextBlock x:Name="StatusText" Grid.Row="3"
                   FontSize="11" Foreground="#555" Margin="0,6,0,0"/>
    </Grid>
</Window>
