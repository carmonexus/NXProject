<Window x:Class="NXProject.Views.AzureDevOpsBacklogHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ADO_Title}"
        Width="820"
        Height="640"
        MinWidth="680"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource ADO_Header}"
                       FontSize="24" FontWeight="SemiBold" Foreground="#2B579A"/>
            <TextBlock Text="{DynamicResource ADO_Sub}"
                       Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#444"/>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="8"
                Background="#F8FAFC" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ADO_1H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource ADO_1P}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource ADO_1a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource ADO_1b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource ADO_1c}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <TextBlock Text="{DynamicResource ADO_2H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource ADO_2P}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource ADO_2a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource ADO_2b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource ADO_2c}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource ADO_2d}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <TextBlock Text="{DynamicResource ADO_3H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource ADO_3P}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource ADO_3P2}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource ADO_4H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource ADO_4a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource ADO_4b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource ADO_4c}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource ADO_4d}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <TextBlock Text="{DynamicResource ADO_5H}" FontSize="16" FontWeight="SemiBold" Foreground="#2B579A" Margin="0,8,0,8"/>
                    <TextBlock Text="{DynamicResource ADO_5P}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource ADO_5a}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource ADO_5b}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource ADO_5c}" TextWrapping="Wrap" Margin="18,0,0,4"/>
                    <TextBlock Text="{DynamicResource ADO_5d}" TextWrapping="Wrap" Margin="18,0,0,12"/>

                    <Border Background="#FFF7E8" BorderBrush="#E8D39A" BorderThickness="1"
                            CornerRadius="6" Padding="12" Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource ADO_Tip}" TextWrapping="Wrap" Foreground="#444"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource ADO_Close}" Width="100" Height="30"
                    IsDefault="True" IsCancel="True" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
