<UserControl x:Class="NXProject.Controls.SprintSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource Sprint_Title}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Sprint_Subtitle}"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MaxWidth="560"
                    HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{DynamicResource Sprint_InitialSprint}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Width="96"
                             Text="{Binding FirstSprintNumber, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="{DynamicResource Sprint_InitialSprintHint}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="{DynamicResource Sprint_DaysPerSprint}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Width="96"
                             Text="{Binding SprintDurationDays, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Text="{DynamicResource Sprint_DaysPerSprintHint}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="{DynamicResource Sprint_Numbering}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <ComboBox Grid.Row="4"
                              Grid.Column="1"
                              Width="110"
                              ItemsSource="{Binding SprintNumberingModes}"
                              SelectedItem="{Binding SprintNumberingMode, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="4"
                               Grid.Column="2"
                               Text="{DynamicResource Sprint_NumberingHint}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="{DynamicResource Sprint_YellowUntil}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="6"
                             Grid.Column="1"
                             Width="96"
                             Text="{Binding CriticalPathRiskSlackDays, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.#}}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="6"
                               Grid.Column="2"
                               Text="{DynamicResource Sprint_SlackHint}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               Text="{DynamicResource Sprint_RedBelow}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="8"
                             Grid.Column="1"
                             Width="96"
                             Text="{Binding CriticalPathCriticalSlackDays, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.#}}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="8"
                               Grid.Column="2"
                               Text="{DynamicResource Sprint_CriticalHint}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Left">
            <Button Content="{DynamicResource Sprint_SaveAsDefault}"
                Padding="14,8"
                Command="{Binding SaveSprintSettingsAsDefaultCommand}"/>
            <TextBlock Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   Text="{DynamicResource Sprint_SaveAsDefaultDesc}"
                   FontSize="12"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   TextWrapping="Wrap"
                   MaxWidth="320"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
