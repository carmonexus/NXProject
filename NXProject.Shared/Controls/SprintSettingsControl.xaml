<UserControl x:Class="NXProject.Controls.SprintSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Sprint"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Centralize aqui as configuracoes de sprint do projeto. Os parametros de SPF agora ficam em uma tela separada no menu Exibir."
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MaxWidth="560"
                    HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Sprint inicial"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Width="96"
                             Text="{Binding FirstSprintNumber, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="Numero exibido na primeira faixa de sprint do Gantt."
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Dias por sprint"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Width="96"
                             Text="{Binding SprintDurationDays, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Text="Quantidade de dias usada para avancar automaticamente a sprint no cronograma."
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Numeracao"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <ComboBox Grid.Row="4"
                              Grid.Column="1"
                              Width="110"
                              ItemsSource="{Binding SprintNumberingModes}"
                              SelectedItem="{Binding SprintNumberingMode, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="4"
                               Grid.Column="2"
                               Text="Escolhe se o cronograma avanca as sprints de forma sequencial, apenas par ou apenas impar."
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="Amarelo ate"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="6"
                             Grid.Column="1"
                             Width="96"
                             Text="{Binding CriticalPathRiskSlackDays, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.#}}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="6"
                               Grid.Column="2"
                               Text="Limite superior da faixa de atencao. Sugestao inicial: use 2d e ajuste conforme a velocidade da empresa."
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               Text="Vermelho abaixo de"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="8"
                             Grid.Column="1"
                             Width="96"
                             Text="{Binding CriticalPathCriticalSlackDays, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.#}}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="8"
                               Grid.Column="2"
                               Text="Limite critico conforme a velocidade da empresa. Sugestao inicial: use 1d; a faixa amarela fica entre este limite e o limite de atencao."
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Content="Gravar configuracao para novos projetos"
                        Padding="14,8"
                        Command="{Binding SaveSprintSettingsAsDefaultCommand}"/>
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="Mantem a configuracao atual como padrao local para os proximos projetos."
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="320"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
