<UserControl x:Class="NXProject.Controls.SfpSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource SFP_Title}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="{DynamicResource SFP_Subtitle}"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MaxWidth="620"
                    HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{DynamicResource SFP_LowLabel}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Width="96"
                             Text="{Binding LowDaysPerSfp, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="{DynamicResource SFP_LowDesc}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="{DynamicResource SFP_MediumLabel}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Width="96"
                             Text="{Binding MediumDaysPerSfp, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Text="{DynamicResource SFP_MediumDesc}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="{DynamicResource SFP_HighLabel}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             Width="96"
                             Text="{Binding HighDaysPerSfp, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="4"
                               Grid.Column="2"
                               Text="{DynamicResource SFP_HighDesc}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MaxWidth="620"
                    HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SFP_OrgH_Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <CheckBox Content="{DynamicResource SFP_ShowOrgH}" 
                              IsChecked="{Binding ShowOriginalHoursColumn, Mode=TwoWay}"
                              FontSize="13"/>
                    <TextBlock Margin="20,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Text="{DynamicResource SFP_OrgH_Desc}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="6"
                    Padding="16"
                    Background="#F6F8FB"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MaxWidth="620"
                    HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SFP_WhatIs_Title}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap">
                        <Run Text="{DynamicResource SFP_WhatIs_Part1}"/>
                        <Run Text="Simple Function Point" FontWeight="SemiBold"/>
                        <Run Text="{DynamicResource SFP_WhatIs_Part2}"/>
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap">
                        <Run Text="{DynamicResource SFP_RangesIntro}"/>
                        <Run Text="{DynamicResource SFP_LowLabel}" FontWeight="SemiBold"/>
                        <Run Text=", "/>
                        <Run Text="{DynamicResource SFP_MediumLabel}" FontWeight="SemiBold"/>
                        <Run Text="{DynamicResource SFP_And}"/>
                        <Run Text="{DynamicResource SFP_HighLabel}" FontWeight="SemiBold"/>
                        <Run Text="."/>
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}"
                               TextWrapping="Wrap">
                        <Hyperlink NavigateUri="https://handwiki.org/wiki/The_Simple_Function_Point_%28SFP%29_method"
                                   RequestNavigate="OnRequestNavigate">
                            <Run Text="{DynamicResource SFP_LearnMore}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
