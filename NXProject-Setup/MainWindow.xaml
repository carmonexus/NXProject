<Window x:Class="NXProject.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Xdata Install"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <StackPanel Margin="24,18,24,18">
        <Grid Margin="0,0,0,2">
            <TextBlock Text="Nexus Xdata Install"
                       FontSize="18" FontWeight="SemiBold" Foreground="#2B579A" VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" Content="✕" ToolTip="{DynamicResource Setup_Close}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="28" Height="28" FontSize="13" Padding="0"
                    Background="Transparent" BorderThickness="0" Foreground="#777"
                    Cursor="Hand" Click="OnCloseClick"/>
        </Grid>
        <TextBlock Text="{DynamicResource Setup_Subtitle}" FontSize="12" Foreground="#777" Margin="0,0,0,12"/>

        <!-- Passo 2: Instalar NXProject (principal, fica em cima) -->
        <Border BorderBrush="#DDE1E6" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Setup_Step2Title}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock x:Name="Step2StatusText" Text="{DynamicResource Setup_Step2Status}"
                           FontSize="12" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock FontSize="10.5" Foreground="#999" TextWrapping="Wrap" Margin="0,0,0,10">
                    <Run x:Name="AppPathRun"/>
                    <Hyperlink Click="OnOpenAppFolder"><Run Text="{DynamicResource Setup_OpenFolder}"/></Hyperlink>
                </TextBlock>
                <Button x:Name="Step2Button" Content="{DynamicResource Setup_Step2Button}" Width="220" Height="30"
                        HorizontalAlignment="Left" Margin="0,0,0,10" Click="OnStep2Click"/>
                <ProgressBar x:Name="InstallProgress" Height="18" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock FontSize="11" Foreground="#777" Margin="0,10,0,0">
                    <Run Text="{DynamicResource Setup_ManualRepo}"/>
                    <Hyperlink NavigateUri="https://github.com/nexusxdata/NXProject/releases/latest"
                               RequestNavigate="OnHyperlinkRequestNavigate">
                        github.com/nexusxdata/NXProject
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Passo 1: .NET 10 Desktop Runtime (pré-requisito, fica abaixo) -->
        <Border BorderBrush="#DDE1E6" BorderThickness="1" CornerRadius="6" Padding="14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Setup_Step1Title}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock x:Name="Step1StatusText" FontSize="12" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button x:Name="Step1Button" Content="{DynamicResource Setup_Step1Button}" Width="220" Height="30"
                        HorizontalAlignment="Left" Click="OnStep1Click"/>
                <TextBlock FontSize="11" Foreground="#777" Margin="0,10,0,0">
                    <Run Text="{DynamicResource Setup_DotNetLink}"/>
                    <Hyperlink NavigateUri="https://dotnet.microsoft.com/download/dotnet/10.0"
                               RequestNavigate="OnHyperlinkRequestNavigate">
                        dotnet.microsoft.com/download/dotnet/10.0
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Passo 3 (opcional): CLIs de IA para Windows (Codex / Claude Code) -->
        <Border BorderBrush="#DDE1E6" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource Setup_Step3Title}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource Setup_Step3Desc}" FontSize="11" Foreground="#777"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox x:Name="CodexCheck" Content="{DynamicResource Setup_Step3Codex}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CodexStatus" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox x:Name="ClaudeCheck" Content="{DynamicResource Setup_Step3Claude}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClaudeStatus" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <CheckBox x:Name="LlamaCheck" Content="{DynamicResource Setup_Step3Llama}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LlamaStatus" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource Setup_Step3CodexNote}" FontSize="10.5" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,2"/>
                <TextBlock Text="{DynamicResource Setup_Step3ClaudeNote}" FontSize="10.5" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,2"/>
                <TextBlock Text="{DynamicResource Setup_Step3LlamaNote}" FontSize="10.5" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Button x:Name="Step3Button" Content="{DynamicResource Setup_Step3Button}" Width="220" Height="30"
                        HorizontalAlignment="Left" Click="OnStep3Click"/>
                <TextBlock x:Name="Step3StatusText" FontSize="11" Foreground="#555" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock FontSize="10.5" Foreground="#999" TextWrapping="Wrap" Margin="0,6,0,0">
                    <Run x:Name="CliPathRun"/>
                    <Hyperlink Click="OnOpenCliFolder"><Run Text="{DynamicResource Setup_OpenFolder}"/></Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="#C0392B" FontSize="11" Margin="0,14,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <Button x:Name="RetryButton" Content="{DynamicResource Setup_Retry}" Width="130" Height="28"
                HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"
                Click="OnRetryClick"/>
    </StackPanel>
</Window>
