<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="Setup_Subtitle">NXProject Installer</sys:String>
    <sys:String x:Key="Setup_Close">Close</sys:String>
    <sys:String x:Key="Setup_Step1Title">Step 1 — .NET 10 Desktop Runtime (approx. 58 MB)</sys:String>
    <sys:String x:Key="Setup_Step1Button">Download and install .NET 10</sys:String>
    <sys:String x:Key="Setup_Step2Title">Step 2 — Install NXProject (approx. 2 MB)</sys:String>
    <sys:String x:Key="Setup_Step2Status">Downloads the latest version and installs it for your user.</sys:String>
    <sys:String x:Key="Setup_Step2Button">Install NXProject</sys:String>
    <sys:String x:Key="Setup_Retry">Try again</sys:String>
    <sys:String x:Key="Setup_Step3Title">Step 3 (optional): install AI — Windows only</sys:String>
    <sys:String x:Key="Setup_Step3Desc">Windows-ONLY install. If you already use it on WSL, the item shows as installed (WSL) and doesn't need reinstalling.</sys:String>
    <sys:String x:Key="Setup_Step3Codex">Codex (OpenAI) (1) — approx. 285 MB</sys:String>
    <sys:String x:Key="Setup_Step3Claude">Claude Code (Anthropic) (3) — approx. 309 MB</sys:String>
    <sys:String x:Key="Setup_Step3Llama">Local AI (LLaMA — Meta) (2) — approx. 2 GB</sys:String>
    <sys:String x:Key="Setup_Step3CodexNote">(1) Has limited free access, with no set deadline at the time of this setup.</sys:String>
    <sys:String x:Key="Setup_Step3LlamaNote">(2) Simpler model; runs 100% on your machine (does NOT use the Internet) and needs a more powerful computer. It is downloaded when NXProject opens.</sys:String>
    <sys:String x:Key="Setup_Step3ClaudeNote">(3) Claude Code is PAID — requires an Anthropic account/subscription. Robust and widely used tool.</sys:String>
    <sys:String x:Key="Setup_OpenFolder">open folder</sys:String>
    <sys:String x:Key="Setup_Installed">✓ already installed</sys:String>
    <sys:String x:Key="Setup_InstalledWin">✓ already installed (Windows)</sys:String>
    <sys:String x:Key="Setup_InstalledWsl">✓ already installed (WSL) — no need to install on Windows</sys:String>
    <sys:String x:Key="Setup_NotInstalled">not installed</sys:String>
    <sys:String x:Key="Setup_Checking">Checking installation…</sys:String>
    <sys:String x:Key="Setup_Step2Installed">✓ NXProject is already installed. Click to check/update to the latest version.</sys:String>
    <sys:String x:Key="Setup_Step2ButtonUpdate">Check for update</sys:String>
    <sys:String x:Key="Setup_PathApp">Installs NXProject at: {0}</sys:String>
    <sys:String x:Key="Setup_PathCli">CLIs (Codex/Claude) at: {0}</sys:String>
    <sys:String x:Key="Setup_Step3LlamaQueued">Local AI (LLaMA) will be downloaded when NXProject opens (Step 2) — into the Manage Local AI folder.</sys:String>
    <sys:String x:Key="Setup_Step3Button">Install checked</sys:String>
    <sys:String x:Key="Setup_Step3PickOne">Check at least one item (Codex, Claude Code or LLaMA).</sys:String>
    <sys:String x:Key="Setup_Step3Done">Done. Installed at: {0} (added to the user PATH; reopen the terminal/NXProject).</sys:String>
    <sys:String x:Key="Setup_Step3Fail">Failed to install CLI: {0}</sys:String>
    <sys:String x:Key="Setup_ManualRepo">Prefer to install manually? Repository: </sys:String>
    <sys:String x:Key="Setup_DotNetLink">.NET 10 Desktop Runtime: </sys:String>

    <sys:String x:Key="Setup_Step1Installed">✓ .NET 10 Desktop Runtime is already installed on this machine.</sys:String>
    <sys:String x:Key="Setup_Step1NotFound">Not found on this machine. Required for NXProject to run.</sys:String>
    <sys:String x:Key="Setup_Step1Downloading">Downloading the .NET 10 Desktop Runtime installer...</sys:String>
    <sys:String x:Key="Setup_Step1Installing">Installing .NET 10 Desktop Runtime (may prompt for administrator permission)...</sys:String>
    <sys:String x:Key="Setup_Step1Success">✓ .NET 10 Desktop Runtime installed successfully.</sys:String>
    <sys:String x:Key="Setup_Step1Fail">Failed to install .NET automatically: {0}&#10;Download manually at: {1}</sys:String>

    <sys:String x:Key="Setup_InstallingBase">Installing runtime and base libraries...</sys:String>
    <sys:String x:Key="Setup_CheckingLatest">Checking the latest NXProject version...</sys:String>
    <sys:String x:Key="Setup_CannotGetLatest">Could not get the latest NXProject version. Check your internet connection and try again.</sys:String>
    <sys:String x:Key="Setup_Downloading">Downloading NXProject {0}...</sys:String>
    <sys:String x:Key="Setup_Installing">Installing NXProject...</sys:String>
    <sys:String x:Key="Setup_IncompleteInstall">Incomplete installation: '{0}' was not found after the download.</sys:String>
    <sys:String x:Key="Setup_Done">Installation complete! Starting NXProject...</sys:String>
    <sys:String x:Key="Setup_InstalledCantOpen">NXProject was installed but could not be opened automatically. Download .NET at: {0}&#10;&#10;Then open NXProject.Community.exe at: {1}</sys:String>
